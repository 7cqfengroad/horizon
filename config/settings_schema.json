[
  {
    "name": "theme_info",
    "theme_name": "Verdura",
    "theme_author": "Verdura",
    "theme_version": "1.0.0",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "colors_accent_1",
        "label": "Primary Color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "colors_accent_2",
        "label": "Secondary Color",
        "default": "#666666"
      },
      {
        "type": "color",
        "id": "colors_background_1",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "colors_text",
        "label": "Text Color",
        "default": "#000000"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading Font",
        "default": "serif"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading Scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 120
      },
      {
        "type": "header",
        "content": "Body Text"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body Font",
        "default": "sans_serif"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body Scale",
        "min": 100,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Page Width"
      },
      {
        "type": "select",
        "id": "page_width",
        "label": "Page Width",
        "options": [
          {
            "value": "1200",
            "label": "1200px"
          },
          {
            "value": "1400",
            "label": "1400px"
          },
          {
            "value": "1600",
            "label": "1600px"
          }
        ],
        "default": "1400"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Section Spacing",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "label": "Grid Horizontal Spacing",
        "min": 8,
        "max": 50,
        "step": 4,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "spacing_grid_vertical",
        "label": "Grid Vertical Spacing",
        "min": 8,
        "max": 50,
        "step": 4,
        "unit": "px",
        "default": 20
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Sharing"
      },
      {
        "type": "image_picker",
        "id": "social_sharing_image",
        "label": "Default Social Sharing Image",
        "info": "Used when specific page doesn't have its own image"
      },
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "url",
        "id": "social_facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_youtube_url",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      {
        "type": "header",
        "content": "Google Analytics"
      },
      {
        "type": "text",
        "id": "google_analytics_id",
        "label": "Google Analytics ID",
        "placeholder": "G-XXXXXXXXXX"
      },
      {
        "type": "header",
        "content": "Google Tag Manager"
      },
      {
        "type": "text",
        "id": "gtm_id",
        "label": "Google Tag Manager ID",
        "placeholder": "GTM-XXXXXXX"
      },
      {
        "type": "header",
        "content": "Facebook Pixel"
      },
      {
        "type": "text",
        "id": "facebook_pixel_id",
        "label": "Facebook Pixel ID"
      }
    ]
  },
  {
    "name": "Performance",
    "settings": [
      {
        "type": "header",
        "content": "Performance Settings"
      },
      {
        "type": "checkbox",
        "id": "enable_performance_monitoring",
        "label": "Enable Performance Monitoring",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable Predictive Search",
        "default": true
      }
    ]
  },
  {
    "name": "Custom Code",
    "settings": [
      {
        "type": "header",
        "content": "Custom JavaScript"
      },
      {
        "type": "textarea",
        "id": "custom_javascript",
        "label": "Custom JavaScript",
        "info": "Add custom JavaScript code that will be executed on every page"
      },
      {
        "type": "header",
        "content": "Custom CSS"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Add custom CSS styles that will be applied to every page"
      }
    ]
  }
] 