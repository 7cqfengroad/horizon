{%- comment -%}
  Homepage Template - Verdura Style Replica
{%- endcomment -%}

<!-- Hero Section with Pearl Necklace Background -->
<section class="hero-section">
  <div class="hero-background">
    <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=1920&h=800&fit=crop&crop=center" 
         alt="Pearl Necklace Heritage" 
         class="hero-bg-image"
         loading="eager">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-welcome">WELCOME TO OUR STORE</p>
    <h1 class="hero-title">Heritage of Style</h1>
    <p class="hero-subtitle">Explore the Collection</p>
    <a href="/collections" class="hero-cta">DISCOVER MORE</a>
  </div>
</section>

<!-- Product Categories Grid -->
<section class="product-categories">
  <div class="container">
    <div class="categories-wrapper">
      <div class="categories-grid">
        <div class="category-item">
          <a href="/collections/bracelets">
            <div class="category-image">
              <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=300&h=300&fit=crop" 
                   alt="Bracelets" loading="lazy">
            </div>
            <h3 class="category-title">Bracelets</h3>
          </a>
        </div>
        
        <div class="category-item">
          <a href="/collections/earclips">
            <div class="category-image">
              <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=300&h=300&fit=crop" 
                   alt="Earclips" loading="lazy">
            </div>
            <h3 class="category-title">Earclips</h3>
          </a>
        </div>
        
        <div class="category-item">
          <a href="/collections/cuffs">
            <div class="category-image">
              <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300&h=300&fit=crop&crop=center" 
                   alt="Cuffs" loading="lazy">
            </div>
            <h3 class="category-title">Cuffs</h3>
          </a>
        </div>
        
        <div class="category-item">
          <a href="/collections/rings">
            <div class="category-image">
              <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=300&h=300&fit=crop" 
                   alt="Rings" loading="lazy">
            </div>
            <h3 class="category-title">Rings</h3>
          </a>
        </div>
        
        <div class="category-item">
          <a href="/collections/necklaces">
            <div class="category-image">
              <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=300&h=300&fit=crop" 
                   alt="Necklaces" loading="lazy">
            </div>
            <h3 class="category-title">Necklaces</h3>
          </a>
        </div>
      </div>
      
      <div class="view-collection-btn">
        <a href="/collections" class="btn btn-outline">VIEW COLLECTION</a>
      </div>
    </div>
  </div>
</section>

<!-- Zodiac Collection Feature -->
<section class="zodiac-section">
  <div class="container">
    <div class="zodiac-content">
      <h2 class="zodiac-title">Zodiac</h2>
      <h3 class="zodiac-subtitle">Pendant Necklaces</h3>
      <p class="zodiac-description">
        Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, 
        Verdura sets diamonds as stars and engraves constellations in gold
      </p>
      <a href="/collections/zodiac-pendant-necklaces" class="btn btn-primary">View Collection</a>
    </div>
  </div>
</section>

<!-- Off-Season Collection -->
<section class="off-season-section">
  <div class="container">
    <div class="off-season-content">
      <h2 class="off-season-title">The Off-Season Collection</h2>
      <p class="off-season-description">
        We are delighted to introduce the Off-Season Collection - over a dozen new archival pieces 
        that we feel captures this paradox of American style. These bangles, lariats, hoops and 
        pendants are meant to be as relevant to your wardrobe in high season as well as off season, 
        whether you don them for an audience or a solo stroll down an empty beach.
      </p>
      <a href="/collections/off-season-collection" class="btn btn-primary">View</a>
    </div>
  </div>
</section>

<!-- Very Verdura Gifts -->
<section class="gifts-section">
  <div class="container">
    <div class="gifts-content">
      <h2 class="gifts-title">Very Verdura</h2>
      <h3 class="gifts-subtitle">Gifts Under $20,000</h3>
      <p class="gifts-description">
        A collection of pieces perfect for gifting and receiving
      </p>
      <a href="/collections/very-verdura-gifts-under-20000" class="btn btn-primary">Shop</a>
    </div>
  </div>
</section>

<!-- Visit The Gallery -->
<section class="visit-section">
  <div class="container">
    <div class="visit-content">
      <h2 class="visit-title">Visit</h2>
      <h3 class="visit-subtitle">The Gallery</h3>
      <p class="visit-description">
        The Verdura gallery is open 10 AM – 5 PM, Monday – Friday. Arrange your visit below
      </p>
      <a href="/pages/visit" class="btn btn-primary">Arrange Visit</a>
    </div>
  </div>
</section>

<!-- New Arrivals -->
<section class="new-arrivals">
  <div class="container">
    <h2 class="section-title">New Arrivals</h2>
    <div class="products-grid">
      {% assign new_arrivals = collections['new-arrivals'].products | default: collections.all.products %}
      {% for product in new_arrivals limit: 8 %}
        <div class="product-card">
          <a href="{{ product.url }}">
            <div class="product-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" 
                     alt="{{ product.title }}" 
                     loading="lazy">
              {% else %}
                <div class="product-placeholder">
                  <span>{{ product.title | slice: 0, 2 | upcase }}</span>
                </div>
              {% endif %}
            </div>
            <h3 class="product-title">{{ product.title }}</h3>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Heritage Section -->
<section class="heritage-section">
  <div class="container">
    <div class="heritage-content">
      <h2 class="heritage-title">Heritage</h2>
      <h3 class="heritage-subtitle">About Fulco Di Verdura</h3>
      <p class="heritage-description">
        Born into Sicilian aristocracy in 1898, Verdura's founder, Duke Fulco di Verdura, 
        began his extraordinary career in Paris as a designer for Coco Chanel. After eight years 
        with Chanel where he, most notably, created the Maltese Cross cuffs that became his signature, 
        Verdura followed his passion for design to America in 1934.
      </p>
      <a href="/pages/the-story" class="btn btn-outline">Discover our Heritage</a>
    </div>
  </div>
</section>

<!-- Newsletter Signup -->
<section class="newsletter-section">
  <div class="container">
    <div class="newsletter-content">
      <h2 class="newsletter-title">Sign up now</h2>
      <h3 class="newsletter-subtitle">Welcome to Verdura</h3>
      <p class="newsletter-description">
        Please join our email list for updates about new collections and special events
      </p>
      
      <form action="/contact#contact_form" method="post" class="newsletter-form" id="contact_form">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        
        <div class="newsletter-input-group">
          <input type="email" 
                 name="contact[email]" 
                 placeholder="Enter your email address"
                 required
                 class="newsletter-input">
          <button type="submit" class="newsletter-submit">Submit</button>
        </div>
      </form>
      
      <div class="newsletter-success" style="display: none;">
        <p>Thank you!</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Reset and Base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Hero Section - Full Width Background */
  .hero-section {
    position: relative;
    height: 60vh;
    min-height: 500px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    max-width: 600px;
    padding: 0 2rem;
  }

  .hero-welcome {
    font-size: 1.2rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
    font-weight: 300;
    opacity: 0.9;
  }

  .hero-title {
    font-size: 4rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 400;
    margin-bottom: 1rem;
    letter-spacing: 0.05rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 1.4rem;
    letter-spacing: 0.1rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .hero-cta {
    display: inline-block;
    padding: 1.2rem 3rem;
    background: transparent;
    border: 2px solid white;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15rem;
    font-size: 1.1rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .hero-cta:hover {
    background: white;
    color: #000;
  }

  /* Container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Product Categories - Clean Layout */
  .product-categories {
    padding: 6rem 0;
    background: #ffffff;
  }

  .categories-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .categories-grid {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 2.5rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
  }

  .category-item {
    text-align: center;
    flex: 0 0 auto;
    width: 150px;
  }

  .category-item a {
    text-decoration: none;
    color: #333;
    display: block;
    transition: transform 0.3s ease;
  }

  .category-item a:hover {
    transform: translateY(-4px);
  }

  .category-image {
    width: 120px;
    height: 120px;
    margin: 0 auto 1.5rem;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid #e8e8e8;
    transition: all 0.3s ease;
    position: relative;
  }

  .category-item a:hover .category-image {
    border-color: #8B4513;
    box-shadow: 0 4px 20px rgba(139, 69, 19, 0.2);
  }

  .category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-item a:hover .category-image img {
    transform: scale(1.1);
  }

  .category-title {
    font-size: 1.4rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.05rem;
    color: #333;
  }

  .view-collection-btn {
    text-align: center;
    margin-top: 2rem;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 1.2rem 3rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15rem;
    font-size: 1.1rem;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 2px solid;
    cursor: pointer;
  }

  .btn-primary {
    background: #8B4513;
    color: white;
    border-color: #8B4513;
  }

  .btn-primary:hover {
    background: transparent;
    color: #8B4513;
  }

  .btn-outline {
    background: transparent;
    color: #333;
    border-color: #333;
  }

  .btn-outline:hover {
    background: #333;
    color: white;
  }

  /* Feature Sections */
  .zodiac-section,
  .off-season-section,
  .gifts-section,
  .visit-section,
  .heritage-section {
    padding: 6rem 0;
    text-align: center;
  }

  .zodiac-section {
    background: #f9f9f9;
  }

  .off-season-section {
    background: white;
  }

  .gifts-section {
    background: #f9f9f9;
  }

  .visit-section {
    background: white;
  }

  .heritage-section {
    background: #f9f9f9;
  }

  .zodiac-title,
  .off-season-title,
  .gifts-title,
  .visit-title,
  .heritage-title {
    font-size: 3.5rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 400;
    margin-bottom: 1rem;
    color: #333;
    letter-spacing: 0.05rem;
  }

  .zodiac-subtitle,
  .gifts-subtitle,
  .visit-subtitle,
  .heritage-subtitle {
    font-size: 2.2rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 300;
    margin-bottom: 2.5rem;
    color: #666;
  }

  .zodiac-description,
  .off-season-description,
  .gifts-description,
  .visit-description,
  .heritage-description {
    font-size: 1.6rem;
    line-height: 1.7;
    margin-bottom: 3.5rem;
    color: #555;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* New Arrivals */
  .new-arrivals {
    padding: 6rem 0;
    background: white;
  }

  .section-title {
    font-size: 3rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 400;
    text-align: center;
    margin-bottom: 4rem;
    color: #333;
    letter-spacing: 0.05rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .product-card {
    text-align: center;
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }

  .product-card a {
    text-decoration: none;
    color: #333;
    display: block;
  }

  .product-image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 2rem;
    font-weight: bold;
  }

  .product-title {
    font-size: 1.4rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    margin: 0;
    padding: 2rem;
    font-weight: 400;
    letter-spacing: 0.05rem;
  }

  /* Newsletter Section */
  .newsletter-section {
    padding: 6rem 0;
    background: #2a2a2a;
    color: white;
    text-align: center;
  }

  .newsletter-title {
    font-size: 3rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 400;
    margin-bottom: 1rem;
    letter-spacing: 0.05rem;
  }

  .newsletter-subtitle {
    font-size: 2rem;
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-weight: 300;
    margin-bottom: 2rem;
    color: #ccc;
  }

  .newsletter-description {
    font-size: 1.5rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: #bbb;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .newsletter-form {
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter-input-group {
    display: flex;
    gap: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  .newsletter-input {
    flex: 1;
    padding: 1.5rem 2rem;
    border: none;
    font-size: 1.4rem;
    background: white;
    color: #333;
  }

  .newsletter-input::placeholder {
    color: #999;
  }

  .newsletter-submit {
    padding: 1.5rem 2.5rem;
    background: #8B4513;
    color: white;
    border: none;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    cursor: pointer;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .newsletter-submit:hover {
    background: #a0501a;
  }

  .newsletter-success {
    margin-top: 2rem;
    font-size: 1.8rem;
    color: #4CAF50;
  }

  /* Mobile Responsiveness */
  @media screen and (max-width: 1024px) {
    .categories-grid {
      gap: 2rem;
    }
    
    .category-item {
      width: 140px;
    }
    
    .category-image {
      width: 110px;
      height: 110px;
    }
  }

  @media screen and (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    
    .hero-welcome {
      font-size: 1rem;
    }
    
    .hero-subtitle {
      font-size: 1.2rem;
    }

    .product-categories {
      padding: 4rem 0;
    }

    .categories-grid {
      gap: 1.5rem;
      justify-content: space-around;
    }
    
    .category-item {
      width: 120px;
    }
    
    .category-image {
      width: 90px;
      height: 90px;
      margin-bottom: 1rem;
    }
    
    .category-title {
      font-size: 1.2rem;
    }

    .zodiac-title,
    .off-season-title,
    .gifts-title,
    .visit-title,
    .heritage-title,
    .section-title,
    .newsletter-title {
      font-size: 2.8rem;
    }

    .zodiac-subtitle,
    .gifts-subtitle,
    .visit-subtitle,
    .heritage-subtitle,
    .newsletter-subtitle {
      font-size: 1.8rem;
    }

    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .newsletter-input-group {
      flex-direction: column;
    }

    .newsletter-input,
    .newsletter-submit {
      border-radius: 4px;
    }
  }

  @media screen and (max-width: 480px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-welcome {
      font-size: 0.9rem;
    }

    .product-categories {
      padding: 3rem 0;
    }

    .categories-grid {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      max-width: 300px;
      margin: 0 auto 3rem;
    }
    
    .category-item {
      width: 100%;
      max-width: 200px;
      display: flex;
      align-items: center;
      text-align: left;
    }
    
    .category-image {
      width: 70px;
      height: 70px;
      margin: 0 1rem 0 0;
      flex-shrink: 0;
    }
    
    .category-title {
      font-size: 1.3rem;
      margin: 0;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }

    .zodiac-section,
    .off-season-section,
    .gifts-section,
    .visit-section,
    .heritage-section,
    .new-arrivals,
    .newsletter-section {
      padding: 3rem 0;
    }
    
    .container {
      padding: 0 1.5rem;
    }
  }
</style>

<script>
  // Newsletter form handling
  document.addEventListener('DOMContentLoaded', function() {
    const newsletterForm = document.getElementById('contact_form');
    const successMessage = document.querySelector('.newsletter-success');
    
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Simulate form submission
        setTimeout(function() {
          newsletterForm.style.display = 'none';
          successMessage.style.display = 'block';
        }, 500);
      });
    }
  });
</script> 