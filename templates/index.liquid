{% section 'collection-slider' %}

{% comment %} 星座系列区域 - Zodiac Section {% endcomment %}
{% comment %} 直接在模板中编写Zodiac Section内容 {% endcomment %}
<section 
  class="zodiac-section section"
  style="background-color: #f7f7f7; padding: 60px 20px;"
>
  <div class="page-width">
    <div class="zodiac-container">
      
      <!-- 左侧图片 -->
      <div class="zodiac-image-left">
        <div class="zodiac-placeholder">
          <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
            <rect width="300" height="400" fill="#e5e5e5"/>
            <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">星座吊坠图片</text>
          </svg>
        </div>
      </div>

      <!-- 中间文字内容 -->
      <div class="zodiac-content">
        <h2 class="zodiac-title">Zodiac</h2>
        <h3 class="zodiac-subtitle">Pendant Necklaces</h3>
        <div class="zodiac-description">
          <p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>
        </div>
        <a href="/collections/zodiac" class="zodiac-btn btn btn--secondary">
          View Collection
        </a>
      </div>

      <!-- 右侧图片 -->
      <div class="zodiac-image-right">
        <div class="zodiac-placeholder">
          <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
            <rect width="300" height="400" fill="#e5e5e5"/>
            <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">星座吊坠图片</text>
          </svg>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
.zodiac-section {
  background-color: #f7f7f7;
}

.zodiac-container {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.zodiac-image-left,
.zodiac-image-right {
  text-align: center;
}

.zodiac-placeholder {
  display: inline-block;
  border-radius: 8px;
  overflow: hidden;
}

.zodiac-content {
  text-align: center;
  padding: 0 20px;
}

.zodiac-title {
  font-size: 2.5rem;
  font-weight: 300;
  margin: 0 0 0.5rem 0;
  color: #333;
  letter-spacing: 0.02em;
}

.zodiac-subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 1.5rem 0;
  color: #666;
  font-style: italic;
}

.zodiac-description {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem 0;
  color: #555;
}

.zodiac-btn {
  margin-top: 1rem;
}

/* 移动端响应式 */
@media screen and (max-width: 768px) {
  .zodiac-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .zodiac-title {
    font-size: 2rem;
  }
  
  .zodiac-subtitle {
    font-size: 1.1rem;
  }
}

@media screen and (max-width: 480px) {
  .zodiac-title {
    font-size: 1.8rem;
  }
}

/* 无障碍支持 */
@media (prefers-reduced-motion: reduce) {
  .zodiac-img {
    transition: none;
  }
  
  .zodiac-img:hover {
    transform: none;
  }
}
</style>

{% comment %} 其他主页sections将通过主题编辑器配置 {% endcomment %}
{{ content_for_index }} 