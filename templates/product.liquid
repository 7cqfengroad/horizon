{%- comment -%}
  Product Template - Verdura Style
{%- endcomment -%}

{%- liquid
  assign product_form_installment_id = 'product-form-installment-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign product_media_count = product.media.size
-%}

<div class="product-page">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumb-separator">/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="breadcrumb-separator">/</span>
      {% endif %}
      <span class="breadcrumb-current">{{ product.title }}</span>
    </nav>

    <div class="product-content">
      <!-- Product Media -->
      <div class="product-media">
        {% if product.media.size > 0 %}
          <div class="product-media-gallery">
            <!-- Main Image -->
            <div class="product-main-image">
              {% for media in product.media limit: 1 %}
                {% if media.media_type == 'image' %}
                  <img src="{{ media | image_url: width: 800 }}" 
                       alt="{{ media.alt | escape }}"
                       id="main-product-image"
                       class="main-image">
                {% elsif media.media_type == 'video' %}
                  <video controls class="main-image">
                    <source src="{{ media.sources[0].url }}" type="{{ media.sources[0].mime_type }}">
                  </video>
                {% endif %}
              {% endfor %}
            </div>

            <!-- Thumbnail Navigation -->
            {% if product.media.size > 1 %}
              <div class="product-thumbnails">
                {% for media in product.media %}
                  <button class="thumbnail {% if forloop.first %}active{% endif %}" 
                          data-media-id="{{ media.id }}"
                          data-media-type="{{ media.media_type }}"
                          data-media-url="{% if media.media_type == 'image' %}{{ media | image_url: width: 800 }}{% else %}{{ media.sources[0].url }}{% endif %}"
                          data-media-alt="{{ media.alt | escape }}">
                    {% if media.media_type == 'image' %}
                      <img src="{{ media | image_url: width: 120 }}" 
                           alt="{{ media.alt | escape }}"
                           loading="lazy">
                    {% elsif media.media_type == 'video' %}
                      <img src="{{ media.preview_image | image_url: width: 120 }}" 
                           alt="{{ media.alt | escape }}"
                           loading="lazy">
                      <div class="video-overlay">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% else %}
          <div class="product-no-media">
            <div class="no-media-placeholder">
              <span>No images available</span>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Product Information -->
      <div class="product-info">
        <div class="product-header">
          <h1 class="product-title">{{ product.title }}</h1>
          
          <div class="product-price">
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="price-sale" id="product-price">{{ current_variant.price | money }}</span>
              <span class="price-compare" id="product-compare-price">{{ current_variant.compare_at_price | money }}</span>
              <span class="price-save">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
            {% else %}
              <span class="price-regular" id="product-price">{{ current_variant.price | money }}</span>
            {% endif %}
          </div>

          {% if product.description != blank %}
            <div class="product-description">
              {{ product.description }}
            </div>
          {% endif %}
        </div>

        <!-- Product Form -->
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" 
              class="product-form" id="product-form-{{ section.id }}">
          
          <!-- Variant Selection -->
          {% unless product.has_only_default_variant %}
            <div class="product-variants">
              {% for option in product.options_with_values %}
                <div class="variant-option">
                  <label class="variant-label">{{ option.name }}:</label>
                  
                  {% if option.name == 'Color' or option.name == 'Colour' %}
                    <!-- Color Swatches -->
                    <div class="color-options">
                      {% for value in option.values %}
                        <input type="radio" 
                               name="options[{{ option.name | escape }}]"
                               value="{{ value | escape }}"
                               id="option-{{ option.position }}-{{ forloop.index }}"
                               {% if option.selected_value == value %}checked{% endif %}
                               class="color-input">
                        <label for="option-{{ option.position }}-{{ forloop.index }}" 
                               class="color-swatch"
                               style="background-color: {{ value | handle | replace: '-', '' }};"
                               title="{{ value }}">
                          <span class="sr-only">{{ value }}</span>
                        </label>
                      {% endfor %}
                    </div>
                  {% else %}
                    <!-- Dropdown for other options -->
                    <select name="options[{{ option.name | escape }}]" 
                            class="variant-select"
                            id="option-{{ option.position }}">
                      {% for value in option.values %}
                        <option value="{{ value | escape }}" 
                                {% if option.selected_value == value %}selected{% endif %}>
                          {{ value }}
                        </option>
                      {% endfor %}
                    </select>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <!-- Quantity and Add to Cart -->
          <div class="product-actions">
            <div class="quantity-selector">
              <label for="quantity" class="quantity-label">Quantity:</label>
              <div class="quantity-input-wrapper">
                <button type="button" class="quantity-btn quantity-minus" aria-label="Decrease quantity">-</button>
                <input type="number" 
                       name="quantity" 
                       id="quantity"
                       value="1" 
                       min="1"
                       class="quantity-input"
                       aria-label="Product quantity">
                <button type="button" class="quantity-btn quantity-plus" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <button type="submit" 
                    class="add-to-cart-btn"
                    {% unless current_variant.available %}disabled{% endunless %}
                    id="add-to-cart-button">
              {% if current_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>

          <!-- Hidden variant input -->
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="product-variant-id">
          
          {% if product.selling_plan_groups.size > 0 %}
            <input type="hidden" name="selling_plan" value="" id="product-selling-plan">
          {% endif %}
        </form>

        <!-- Product Details -->
        {% if product.metafields.custom.materials or product.metafields.custom.care_instructions %}
          <div class="product-details">
            <details class="product-detail-item">
              <summary class="detail-title">Product Details</summary>
              <div class="detail-content">
                {% if product.metafields.custom.materials %}
                  <p><strong>Materials:</strong> {{ product.metafields.custom.materials }}</p>
                {% endif %}
                {% if product.metafields.custom.care_instructions %}
                  <p><strong>Care Instructions:</strong> {{ product.metafields.custom.care_instructions }}</p>
                {% endif %}
              </div>
            </details>
          </div>
        {% endif %}

        <!-- Shipping Information -->
        <div class="product-shipping-info">
          <div class="shipping-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
            </svg>
            <span>Free shipping on orders over $100</span>
          </div>
          
          <div class="shipping-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>30-day return policy</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Related Products -->
{% if product.collections.size > 0 %}
  {% assign related_collection = product.collections.first %}
  {% assign related_products = related_collection.products | where: 'available' | limit: 4 %}
  
  {% if related_products.size > 1 %}
    <div class="related-products">
      <div class="container">
        <h2 class="section-title">You May Also Like</h2>
        <div class="related-products-grid">
          {% for related_product in related_products %}
            {% unless related_product.id == product.id %}
              <div class="product-card">
                <a href="{{ related_product.url }}">
                  <div class="product-image">
                    {% if related_product.featured_image %}
                      <img src="{{ related_product.featured_image | image_url: width: 300 }}" 
                           alt="{{ related_product.title }}" 
                           loading="lazy">
                    {% else %}
                      <div class="product-placeholder">No Image</div>
                    {% endif %}
                  </div>
                  <h3 class="product-title">{{ related_product.title }}</h3>
                  <div class="product-price">
                    <span class="price-regular">{{ related_product.price | money }}</span>
                  </div>
                </a>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}

<style>
  /* Product Page Layout */
  .product-page {
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Breadcrumb */
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 1.4rem;
  }

  .breadcrumb a {
    color: rgba(var(--color-base-text), 0.7);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: rgb(var(--color-base-accent-1));
  }

  .breadcrumb-separator {
    margin: 0 1rem;
    color: rgba(var(--color-base-text), 0.5);
  }

  .breadcrumb-current {
    color: rgb(var(--color-base-text));
  }

  /* Product Content */
  .product-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 6rem;
  }

  /* Product Media */
  .product-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-main-image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-thumbnails {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 1rem;
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 1;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: none;
    padding: 0;
    transition: border-color 0.3s ease;
  }

  .thumbnail.active,
  .thumbnail:hover {
    border-color: rgb(var(--color-base-accent-1));
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-no-media {
    aspect-ratio: 1;
  }

  .no-media-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5, #e0e0e0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 1.6rem;
    border-radius: 8px;
  }

  /* Product Information */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-title {
    font-size: 2.8rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .product-price {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .price-regular,
  .price-sale {
    font-size: 2.4rem;
    font-weight: 600;
    color: rgb(var(--color-base-text));
  }

  .price-compare {
    font-size: 2rem;
    color: rgba(var(--color-base-text), 0.6);
    text-decoration: line-through;
  }

  .price-save {
    background: #ff4444;
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .product-description {
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text), 0.8);
  }

  /* Product Form */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-variants {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .variant-option {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .variant-label {
    font-size: 1.6rem;
    font-weight: 600;
    color: rgb(var(--color-base-text));
  }

  /* Color Swatches */
  .color-options {
    display: flex;
    gap: 1rem;
  }

  .color-input {
    display: none;
  }

  .color-swatch {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: 3px solid transparent;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .color-input:checked + .color-swatch {
    border-color: rgb(var(--color-base-accent-1));
    transform: scale(1.1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Variant Select */
  .variant-select {
    padding: 1.2rem;
    border: 2px solid rgba(var(--color-base-text), 0.3);
    font-size: 1.6rem;
    background: rgb(var(--color-base-background-1));
    color: rgb(var(--color-base-text));
    border-radius: 4px;
    width: 100%;
  }

  /* Product Actions */
  .product-actions {
    display: flex;
    gap: 2rem;
    align-items: end;
  }

  .quantity-selector {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .quantity-label {
    font-size: 1.4rem;
    font-weight: 600;
    color: rgb(var(--color-base-text));
  }

  .quantity-input-wrapper {
    display: flex;
    border: 2px solid rgba(var(--color-base-text), 0.3);
    border-radius: 4px;
    overflow: hidden;
  }

  .quantity-btn {
    background: rgba(var(--color-base-text), 0.1);
    border: none;
    padding: 1rem 1.5rem;
    font-size: 1.6rem;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .quantity-btn:hover {
    background: rgba(var(--color-base-text), 0.2);
  }

  .quantity-input {
    border: none;
    padding: 1rem;
    text-align: center;
    font-size: 1.6rem;
    width: 6rem;
    background: rgb(var(--color-base-background-1));
  }

  .add-to-cart-btn {
    flex: 1;
    padding: 1.5rem 3rem;
    background: rgb(var(--color-base-accent-1));
    color: rgb(var(--color-base-background-1));
    border: none;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .add-to-cart-btn:hover:not(:disabled) {
    background: rgba(var(--color-base-accent-1), 0.8);
    transform: translateY(-2px);
  }

  .add-to-cart-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  /* Product Details */
  .product-details {
    border-top: 1px solid rgba(var(--color-base-text), 0.1);
    padding-top: 2rem;
  }

  .product-detail-item {
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
  }

  .detail-title {
    padding: 1.5rem 0;
    font-size: 1.6rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .detail-title::-webkit-details-marker {
    display: none;
  }

  .detail-content {
    padding-bottom: 1.5rem;
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text), 0.8);
  }

  /* Shipping Info */
  .product-shipping-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background: rgba(var(--color-base-accent-1), 0.05);
    border-radius: 8px;
  }

  .shipping-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    color: rgba(var(--color-base-text), 0.8);
  }

  .shipping-item svg {
    color: rgb(var(--color-base-accent-1));
  }

  /* Related Products */
  .related-products {
    padding: 4rem 0;
    background: rgb(var(--color-base-background-2));
  }

  .section-title {
    font-size: 2.8rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    text-align: center;
    margin-bottom: 3rem;
  }

  .related-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
  }

  .product-card {
    text-align: center;
    transition: transform 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-card a {
    text-decoration: none;
    color: rgb(var(--color-base-text));
    display: block;
  }

  .product-image {
    aspect-ratio: 1;
    margin-bottom: 1.5rem;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5, #e0e0e0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 1.2rem;
  }

  .product-card .product-title {
    font-size: 1.6rem;
    font-family: var(--font-heading-family);
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }

  .product-card .product-price {
    margin: 0;
  }

  .product-card .price-regular {
    font-size: 1.4rem;
    font-weight: 600;
  }

  /* Mobile Responsiveness */
  @media screen and (max-width: 768px) {
    .product-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .product-title {
      font-size: 2.4rem;
    }

    .price-regular,
    .price-sale {
      font-size: 2rem;
    }

    .product-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .quantity-selector {
      align-self: flex-start;
    }

    .related-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media screen and (max-width: 480px) {
    .product-thumbnails {
      grid-template-columns: repeat(4, 1fr);
    }

    .related-products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Thumbnail navigation
    const thumbnails = document.querySelectorAll('.thumbnail');
    const mainImage = document.getElementById('main-product-image');

    thumbnails.forEach(thumbnail => {
      thumbnail.addEventListener('click', function() {
        // Remove active class from all thumbnails
        thumbnails.forEach(t => t.classList.remove('active'));
        
        // Add active class to clicked thumbnail
        this.classList.add('active');
        
        // Update main image
        const mediaType = this.dataset.mediaType;
        const mediaUrl = this.dataset.mediaUrl;
        const mediaAlt = this.dataset.mediaAlt;
        
        if (mediaType === 'image') {
          if (mainImage.tagName === 'VIDEO') {
            // Replace video with image
            const newImg = document.createElement('img');
            newImg.src = mediaUrl;
            newImg.alt = mediaAlt;
            newImg.id = 'main-product-image';
            newImg.className = 'main-image';
            mainImage.parentNode.replaceChild(newImg, mainImage);
          } else {
            mainImage.src = mediaUrl;
            mainImage.alt = mediaAlt;
          }
        } else if (mediaType === 'video') {
          if (mainImage.tagName === 'IMG') {
            // Replace image with video
            const newVideo = document.createElement('video');
            newVideo.controls = true;
            newVideo.id = 'main-product-image';
            newVideo.className = 'main-image';
            const source = document.createElement('source');
            source.src = mediaUrl;
            newVideo.appendChild(source);
            mainImage.parentNode.replaceChild(newVideo, mainImage);
          }
        }
      });
    });

    // Quantity controls
    const quantityInput = document.getElementById('quantity');
    const minusBtn = document.querySelector('.quantity-minus');
    const plusBtn = document.querySelector('.quantity-plus');

    if (minusBtn && plusBtn && quantityInput) {
      minusBtn.addEventListener('click', function() {
        const currentValue = parseInt(quantityInput.value);
        if (currentValue > 1) {
          quantityInput.value = currentValue - 1;
        }
      });

      plusBtn.addEventListener('click', function() {
        const currentValue = parseInt(quantityInput.value);
        quantityInput.value = currentValue + 1;
      });
    }

    // Variant selection
    const variantSelectors = document.querySelectorAll('input[name*="options"], select[name*="options"]');
    const variantIdInput = document.getElementById('product-variant-id');
    const priceElement = document.getElementById('product-price');
    const comparePriceElement = document.getElementById('product-compare-price');
    const addToCartButton = document.getElementById('add-to-cart-button');

    // Product variants data (would be populated by Shopify)
    const productVariants = {{ product.variants | json }};

    function updateVariant() {
      const selectedOptions = {};
      
      variantSelectors.forEach(selector => {
        const optionName = selector.name.match(/options\[(.*?)\]/)[1];
        selectedOptions[optionName] = selector.value;
      });

      // Find matching variant
      const selectedVariant = productVariants.find(variant => {
        return variant.options.every((option, index) => {
          const optionName = Object.keys(selectedOptions)[index];
          return selectedOptions[optionName] === option;
        });
      });

      if (selectedVariant) {
        // Update variant ID
        variantIdInput.value = selectedVariant.id;
        
        // Update price
        if (priceElement) {
          priceElement.textContent = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: '{{ cart.currency.iso_code }}',
            minimumFractionDigits: 2
          }).format(selectedVariant.price / 100);
        }

        // Update compare price
        if (comparePriceElement) {
          if (selectedVariant.compare_at_price && selectedVariant.compare_at_price > selectedVariant.price) {
            comparePriceElement.textContent = new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: '{{ cart.currency.iso_code }}',
              minimumFractionDigits: 2
            }).format(selectedVariant.compare_at_price / 100);
            comparePriceElement.style.display = 'inline';
          } else {
            comparePriceElement.style.display = 'none';
          }
        }

        // Update add to cart button
        if (addToCartButton) {
          if (selectedVariant.available) {
            addToCartButton.disabled = false;
            addToCartButton.textContent = 'Add to Cart';
          } else {
            addToCartButton.disabled = true;
            addToCartButton.textContent = 'Sold Out';
          }
        }
      }
    }

    // Add event listeners to variant selectors
    variantSelectors.forEach(selector => {
      selector.addEventListener('change', updateVariant);
    });

    // Add to cart form submission
    const productForm = document.getElementById('product-form-{{ section.id }}');
    if (productForm) {
      productForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        
        fetch('{{ routes.cart_add_url }}', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (data.status === 422) {
            console.error('Error adding to cart:', data.description);
          } else {
            // Success - could show notification or update cart
            console.log('Added to cart successfully');
            
            // Update cart count if there's a cart icon
            const cartIcon = document.getElementById('cart-icon-bubble');
            if (cartIcon) {
              fetch('{{ routes.cart_url }}.js')
                .then(response => response.json())
                .then(cart => {
                  const cartCount = cartIcon.querySelector('.header__cart-count');
                  if (cartCount) {
                    cartCount.textContent = cart.item_count;
                  } else if (cart.item_count > 0) {
                    const newCount = document.createElement('span');
                    newCount.className = 'header__cart-count';
                    newCount.textContent = cart.item_count;
                    cartIcon.appendChild(newCount);
                  }
                });
            }
          }
        })
        .catch(error => {
          console.error('Error:', error);
        });
      });
    }
  });
</script> 