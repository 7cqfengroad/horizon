 → {% comment %}
  Blog Template
{% endcomment %}

<div class="page-width">
  <div class="blog">
    <h1 class="h1">{{ blog.title }}</h1>
    
    {% for article in blog.articles %}
      <article class="blog__article">
        <h2 class="h2"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <time>{{ article.published_at | date: '%B %d, %Y' }}</time>
        <div class="article__summary">
          {{ article.summary | default: article.excerpt }}
        </div>
        <a href="{{ article.url }}">Read more</a>
      </article>
    {% endfor %}
  </div>
</div>