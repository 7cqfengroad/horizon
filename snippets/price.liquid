{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  @param {product} product_resource - The product to render
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
{%- enddoc -%}

{%- liquid
  assign money_price = product.price | money
  if settings.currency_code_enabled
    assign money_price = product.price | money_with_currency
  endif

  if product.price_varies
    assign money_price_min = product.price_min | money
    if settings.currency_code_enabled
      assign money_price_min = product.price_min | money_with_currency
    endif
  endif

  assign money_price_max = product.price_max | money
  if settings.currency_code_enabled
    assign money_price_max = product.price_max | money_with_currency
  endif

  if product.compare_at_price > product.price
    assign money_compare_price = product.compare_at_price | money
    if settings.currency_code_enabled
      assign money_compare_price = product.compare_at_price | money_with_currency
    endif
  endif

  assign has_sale = false
  if product.compare_at_price > product.price
    assign has_sale = true
  endif
-%}

<div class="price">
  {%- if product.price_varies -%}
    <div class="price__container">
      <span class="price__from">{{ 'products.product.price.from_price_html' | t: price: money_price_min }}</span>
    </div>
  {%- else -%}
    <div class="price__container">
      {%- if has_sale -%}
        <span class="price__regular">
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          <s class="price__compare">{{ money_compare_price }}</s>
        </span>
        <span class="price__sale">
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
          <span class="price__current">{{ money_price }}</span>
        </span>
      {%- else -%}
        <span class="price__regular">
          <span class="price__current">{{ money_price }}</span>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
    <div class="price__unit">
      {%- capture unit_price_base_unit -%}
        {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
          {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}
        {%- endif -%}
        {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
      {%- endcapture -%}

      {{ product.selected_or_first_available_variant.unit_price | money }}/{{ unit_price_base_unit }}
    </div>
  {%- endif -%}
</div>

<style>
  .price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .price__container {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .price__current {
    font-weight: 500;
    color: var(--color-base-text);
  }

  .price__compare {
    color: rgba(var(--color-base-text), 0.6);
    font-size: 0.9em;
  }

  .price__sale .price__current {
    color: var(--color-base-accent-1);
  }

  .price__from {
    font-weight: 400;
    color: var(--color-base-text);
  }

  .price__unit {
    font-size: 0.8em;
    color: rgba(var(--color-base-text), 0.7);
    margin-top: 0.25rem;
  }

  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }
</style>
