{%- capture og_title -%}
  {%- if template.name == 'product' -%}
    {{ product.title | strip_html }}
  {%- elsif template.name == 'collection' -%}
    {{ collection.title | strip_html }}
  {%- else -%}
    {{ page_title | strip_html }}
  {%- endif -%}
{%- endcapture -%}

{%- capture og_url -%}
  {{ request.origin }}{{ canonical_url | remove: request.origin }}
{%- endcapture -%}

{%- capture og_type -%}
  {%- if template.name == 'product' -%}
    product
  {%- elsif template.name == 'article' -%}
    article
  {%- else -%}
    website
  {%- endif -%}
{%- endcapture -%}

{%- capture og_description -%}
  {%- if template.name == 'product' -%}
    {{ product.description | strip_html | truncatewords: 25 | escape }}
  {%- elsif template.name == 'collection' -%}
    {{ collection.description | strip_html | truncatewords: 25 | escape }}
  {%- elsif template.name == 'article' -%}
    {{ article.excerpt | strip_html | truncatewords: 25 | escape }}
  {%- elsif page_description -%}
    {{ page_description | escape }}
  {%- else -%}
    {{ shop.description | strip_html | truncatewords: 25 | escape }}
  {%- endif -%}
{%- endcapture -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description }}">

{%- if template.name == 'product' -%}
  <meta property="product:brand" content="{{ product.vendor | escape }}">
  <meta property="product:availability" content="{%- if product.available -%}in stock{%- else -%}out of stock{%- endif -%}">
  <meta property="product:condition" content="new">
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.00 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:retailer_item_id" content="{{ product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id }}">
{%- endif -%}

{%- capture og_image_alt -%}
  {%- if template.name == 'product' -%}
    {{ product.featured_media.alt | default: product.title | strip_html | escape }}
  {%- elsif template.name == 'collection' -%}
    {{ collection.featured_image.alt | default: collection.title | strip_html | escape }}
  {%- elsif template.name == 'article' -%}
    {{ article.image.alt | default: article.title | strip_html | escape }}
  {%- else -%}
    {{ settings.share_image.alt | default: shop.name | strip_html | escape }}
  {%- endif -%}
{%- endcapture -%}

{%- capture og_image -%}
  {%- if template.name == 'product' -%}
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 1200, height: 628 }}
    {%- endif -%}
  {%- elsif template.name == 'collection' -%}
    {%- if collection.featured_image -%}
      {{ collection.featured_image | image_url: width: 1200, height: 628 }}
    {%- endif -%}
  {%- elsif template.name == 'article' -%}
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200, height: 628 }}
    {%- endif -%}
  {%- elsif settings.share_image -%}
    {{ settings.share_image | image_url: width: 1200, height: 628 }}
  {%- endif -%}
{%- endcapture -%}

{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image }}">
  <meta property="og:image:secure_url" content="https:{{ og_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="628">
  <meta property="og:image:alt" content="{{ og_image_alt }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">

{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: '/' | last | prepend: '@' }}">
{%- endif -%}

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if product.featured_media -%}
      {%- assign image_size = product.featured_media.width | append: 'x' -%}
      "image": [
        {{ product.featured_media | image_url: width: product.featured_media.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%} 