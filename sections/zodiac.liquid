{% comment %}
  Zodiac Section
  专门为星座系列设计的两侧图片+中间文字布局
{% endcomment %}

<section 
  id="Zodiac-{{ section.id }}" 
  class="zodiac-section"
  style="
    background-color: {{ section.settings.background_color | default: '#f7f7f7' }};
    padding: {{ section.settings.section_padding_top | default: 60 }}px 20px {{ section.settings.section_padding_bottom | default: 60 }}px;
  "
>
  <div class="zodiac-wrapper">
    {%- comment -%} 左侧图片 {%- endcomment -%}
    <div class="zodiac-image zodiac-image--left">
      {%- if section.settings.image_left != blank -%}
        {{ section.settings.image_left | image_url: width: 600 | image_tag:
          loading: 'lazy',
          alt: section.settings.image_left_alt | default: section.settings.title,
          class: 'zodiac-img'
        }}
      {%- else -%}
        <div class="zodiac-placeholder">
          <span class="visually-hidden">{{ 'sections.zodiac.image_placeholder' | t }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 中间文字内容 {%- endcomment -%}
    <div class="zodiac-content">
      <div class="zodiac-content-wrapper">
        {%- if section.settings.title != blank -%}
          <h2 class="zodiac-title">
            {{ section.settings.title | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <h3 class="zodiac-subtitle">
            {{ section.settings.subtitle | escape }}
          </h3>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="zodiac-description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
          <a 
            href="{{ section.settings.button_url }}" 
            class="zodiac-button btn btn--secondary"
          >
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} 右侧图片 {%- endcomment -%}
    <div class="zodiac-image zodiac-image--right">
      {%- if section.settings.image_right != blank -%}
        {{ section.settings.image_right | image_url: width: 600 | image_tag:
          loading: 'lazy',
          alt: section.settings.image_right_alt | default: section.settings.title,
          class: 'zodiac-img'
        }}
      {%- else -%}
        <div class="zodiac-placeholder">
          <span class="visually-hidden">{{ 'sections.zodiac.image_placeholder' | t }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.zodiac-section {
  background-color: #f7f7f7;
}

.zodiac-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;
  align-items: center;
}

/* 图片样式 */
.zodiac-image {
  position: relative;
}

.zodiac-img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  transition: transform 0.3s ease;
}

.zodiac-image:hover .zodiac-img {
  transform: scale(1.02);
}

.zodiac-placeholder {
  width: 100%;
  aspect-ratio: 4 / 5;
  background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%),
              linear-gradient(-45deg, #f0f0f0 25%, transparent 25%),
              linear-gradient(45deg, transparent 75%, #f0f0f0 75%),
              linear-gradient(-45deg, transparent 75%, #f0f0f0 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 文字内容样式 */
.zodiac-content {
  text-align: center;
  padding: 0 20px;
}

.zodiac-content-wrapper {
  max-width: 500px;
  margin: 0 auto;
}

.zodiac-title {
  font-size: 2.5rem;
  font-weight: 300;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
  color: #333;
  letter-spacing: 0.02em;
}

.zodiac-subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 1.5rem 0;
  color: #666;
  font-style: italic;
}

.zodiac-description {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem 0;
  color: #555;
}

.zodiac-description p {
  margin: 0 0 1rem 0;
}

.zodiac-description p:last-child {
  margin-bottom: 0;
}

.zodiac-button {
  margin-top: 1rem;
}

/* 响应式设计 */
@media screen and (max-width: 768px) {
  .zodiac-wrapper {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .zodiac-content {
    padding: 0 10px;
  }
  
  .zodiac-title {
    font-size: 2rem;
  }
  
  .zodiac-subtitle {
    font-size: 1.1rem;
  }
}

@media screen and (max-width: 480px) {
  .zodiac-title {
    font-size: 1.8rem;
  }
  
  .zodiac-content {
    padding: 0 5px;
  }
}

/* 高对比度模式 */
@media (prefers-contrast: more) {
  .zodiac-title,
  .zodiac-subtitle,
  .zodiac-description {
    color: #000;
  }
  
  .zodiac-img {
    border: 2px solid #000;
  }
}

/* 减少动画模式 */
@media (prefers-reduced-motion: reduce) {
  .zodiac-img {
    transition: none;
  }
  
  .zodiac-image:hover .zodiac-img {
    transform: none;
  }
}
</style>

{% schema %}
{
  "name": "星座系列",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "左侧图片"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "左侧图片描述",
      "default": "Zodiac Pendant Capricorn"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "右侧图片"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "右侧图片描述",
      "default": "Zodiac Pendant Pisces"
    },
    {
      "type": "header",
      "content": "文字内容"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Zodiac"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "Pendant Necklaces"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述文字",
      "default": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接",
      "default": "/collections/zodiac-pendant-necklaces"
    },
    {
      "type": "header",
      "content": "样式设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "顶部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "底部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "星座系列",
      "settings": {
        "title": "Zodiac",
        "subtitle": "Pendant Necklaces",
        "description": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>",
        "button_text": "View Collection",
        "button_url": "/collections/zodiac-pendant-necklaces"
      }
    }
  ]
}
{% endschema %} 