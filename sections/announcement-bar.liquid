{%- comment -%}
  Announcement Bar Section
{%- endcomment -%}

{%- if section.settings.enable -%}
  <div class="announcement-bar">
    <div class="announcement-bar__content">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          {{ section.settings.text | escape }}
        </a>
      {% else %}
        <span class="announcement-bar__text">
          {{ section.settings.text | escape }}
        </span>
      {% endif %}
    </div>
  </div>
{% endif %}

<style>
  .announcement-bar {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
    padding: {{ section.settings.padding_vertical }}px 2rem;
    position: relative;
    z-index: 10;
  }

  .announcement-bar__content {
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .announcement-bar__text,
  .announcement-bar__link {
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    margin: 0;
    display: block;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .announcement-bar__link:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    .announcement-bar {
      padding: {{ section.settings.padding_vertical | divided_by: 2 }}px 1.5rem;
    }

    .announcement-bar__text,
    .announcement-bar__link {
      font-size: 1.3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "default": false,
      "label": "Show announcement"
    },
    {
      "type": "text",
      "id": "text",
      "default": "Free shipping on orders over $100",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#1a1a1a",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    }
  ]
}
{% endschema %} 