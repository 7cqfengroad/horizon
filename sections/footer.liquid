{% comment %}
  Verdura Footer Section - 页脚
  包含联系信息、社交媒体链接和法律信息
{% endcomment %}

<footer class="site-footer" data-section-id="{{ section.id }}" data-section-type="footer">
  <div class="footer-content">
    <div class="footer-main">
      <!-- Logo -->
      <div class="footer-logo">
        {% if section.settings.footer_logo != blank %}
          <img 
            src="{{ section.settings.footer_logo | image_url: width: 200 }}" 
            alt="{{ shop.name }}"
            width="200"
            height="auto"
            loading="lazy">
        {% else %}
          <h2 class="footer-site-name">{{ shop.name }}</h2>
        {% endif %}
      </div>

      <!-- 社交媒体链接 -->
      <div class="footer-social">
        {% for block in section.blocks %}
          {% if block.type == 'social_link' %}
            <a 
              href="{{ block.settings.url }}" 
              class="social-link"
              target="_blank"
              rel="noopener"
              aria-label="{{ block.settings.platform | capitalize }}"
              {{ block.shopify_attributes }}>
              <span class="sr-only">{{ block.settings.platform | capitalize }}</span>
              {% case block.settings.platform %}
                {% when 'facebook' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                {% when 'instagram' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 6.618 5.367 11.986 11.988 11.986s11.987-5.368 11.987-11.986C24.014 5.367 18.635.001 12.017.001zM8.449 16.988c-1.297 0-2.448-.49-3.324-1.297C4.198 14.895 3.708 13.744 3.708 12.447s.49-2.448 1.297-3.324c.876-.807 2.027-1.297 3.324-1.297s2.448.49 3.324 1.297c.807.876 1.297 2.027 1.297 3.324s-.49 2.448-1.297 3.324c-.876.807-2.027 1.297-3.324 1.297zm7.599 0c-1.297 0-2.448-.49-3.324-1.297-.807-.876-1.297-2.027-1.297-3.324s.49-2.448 1.297-3.324c.876-.807 2.027-1.297 3.324-1.297s2.448.49 3.324 1.297c.807.876 1.297 2.027 1.297 3.324s-.49 2.448-1.297 3.324c-.876.807-2.027 1.297-3.324 1.297z"/>
                  </svg>
                {% when 'youtube' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
              {% endcase %}
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <!-- 联系信息 -->
      <div class="footer-contact">
        {% if section.settings.contact_address != blank %}
          <p class="footer-address">{{ section.settings.contact_address }}</p>
        {% endif %}
        {% if section.settings.contact_phone != blank %}
          <p class="footer-phone">
            <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
              {{ 'footer.phone_label' | t }}: {{ section.settings.contact_phone }}
            </a>
          </p>
        {% endif %}
        {% if section.settings.contact_email != blank %}
          <p class="footer-email">
            <a href="mailto:{{ section.settings.contact_email }}">
              {{ 'footer.email_label' | t }}: {{ section.settings.contact_email }}
            </a>
          </p>
        {% endif %}
      </div>

      <!-- 页面链接 -->
      <div class="footer-links">
        {% for block in section.blocks %}
          {% if block.type == 'footer_link' %}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              {{ block.settings.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- 版权和法律信息 -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.copyright' | t }}</p>
      </div>
      
      {% if section.settings.website_credit_text != blank %}
        <div class="footer-credit">
          {% if section.settings.website_credit_url != blank %}
            <a href="{{ section.settings.website_credit_url }}" target="_blank" rel="noopener">
              {{ section.settings.website_credit_text }}
            </a>
          {% else %}
            <p>{{ section.settings.website_credit_text }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #262626;
    color: #ffffff;
    padding: 60px 0 20px;
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
    margin-bottom: 40px;
  }

  .footer-logo img {
    max-height: 60px;
    width: auto;
  }

  .footer-site-name {
    font-family: serif;
    font-size: 24px;
    font-weight: 400;
    margin: 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .footer-social {
    display: flex;
    gap: 20px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #ffffff;
    transition: color 0.2s ease;
    min-height: 44px; /* 无障碍触摸目标 */
  }

  .social-link:hover,
  .social-link:focus {
    color: #cccccc;
    outline: none;
  }

  .social-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .footer-contact p {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 1.6;
  }

  .footer-contact a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact a:hover,
  .footer-contact a:focus {
    color: #cccccc;
    text-decoration: underline;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
    padding: 4px 0;
  }

  .footer-links a:hover,
  .footer-links a:focus {
    color: #cccccc;
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    font-size: 12px;
  }

  .footer-copyright p,
  .footer-credit p {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
  }

  .footer-credit a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-credit a:hover,
  .footer-credit a:focus {
    color: #ffffff;
    text-decoration: underline;
  }

  /* 响应式设计 */
  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      align-items: flex-start;
    }

    .footer-logo {
      flex: 0 0 auto;
    }

    .footer-social {
      flex: 0 0 auto;
      order: 3;
    }

    .footer-contact {
      flex: 1;
      max-width: 300px;
    }

    .footer-links {
      flex: 0 0 auto;
      order: 2;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    .footer-content {
      padding: 0 60px;
    }

    .footer-main {
      gap: 60px;
    }
  }

  /* 高对比度模式 */
  @media (prefers-contrast: more) {
    .site-footer {
      background: #000000;
      border-top: 3px solid #ffffff;
    }

    .social-link,
    .footer-contact a,
    .footer-links a {
      border: 1px solid transparent;
    }

    .social-link:focus,
    .footer-contact a:focus,
    .footer-links a:focus {
      border-color: #ffffff;
    }
  }

  /* 打印样式 */
  @media print {
    .site-footer {
      background: #ffffff;
      color: #000000;
      border-top: 1px solid #000000;
    }

    .footer-social {
      display: none;
    }
  }

  /* 屏幕阅读器专用 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "site-footer-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Address",
      "default": "745 Fifth Avenue, Suite 1205 New York, NY 10151"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone Number",
      "default": "+1 (212) 758-3388"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email Address",
      "default": "info@verdura.com"
    },
    {
      "type": "header",
      "content": "Website Credit"
    },
    {
      "type": "text",
      "id": "website_credit_text",
      "label": "Website Credit Text",
      "default": "Website by The Beaux Arts"
    },
    {
      "type": "url",
      "id": "website_credit_url",
      "label": "Website Credit URL"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Social Platform",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            }
          ]
        },
        {
          "type": "url",
          "id": "url",
          "label": "Social Media URL"
        }
      ]
    },
    {
      "type": "footer_link",
      "name": "Footer Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Link Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "social_link",
        "settings": {
          "platform": "facebook",
          "url": "https://www.facebook.com/verdura/"
        }
      },
      {
        "type": "social_link",
        "settings": {
          "platform": "instagram",
          "url": "https://www.instagram.com/verdurajewelry/"
        }
      },
      {
        "type": "social_link",
        "settings": {
          "platform": "youtube",
          "url": "https://youtube.com/@verdurajewelry"
        }
      },
      {
        "type": "footer_link",
        "settings": {
          "title": "Online Accessibility Statement",
          "url": "/pages/online-accessibility-statement"
        }
      },
      {
        "type": "footer_link",
        "settings": {
          "title": "Catalogues",
          "url": "/pages/catalogues"
        }
      },
      {
        "type": "footer_link",
        "settings": {
          "title": "Customer Service / FAQ",
          "url": "/pages/customer-service"
        }
      }
    ]
  }
}
{% endschema %} 