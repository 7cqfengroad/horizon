{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="footer section-padding" role="contentinfo">
  <div class="container">
    <div class="footer__content">
      
      <!-- Logo -->
      <div class="footer__logo">
        <a href="{{ routes.root_url }}" class="footer__logo-link">
          {%- if settings.logo != blank -%}
            <img 
              src="{{ settings.logo | image_url: width: 150 }}"
              alt="{{ shop.name | escape }}"
              width="auto"
              height="30"
              class="footer__logo-image"
            >
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Social Media -->
      <div class="footer__social">
        <ul class="footer__social-list" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li class="footer__social-item">
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="footer__social-link">
                <svg class="icon icon-instagram" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                  <line x1="17.5" y1="6.5" x2="17.5" y2="6.51" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="visually-hidden">Instagram</span>
              </a>
            </li>
          {%- endif -%}
          
          {%- if settings.social_facebook_link != blank -%}
            <li class="footer__social-item">
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" class="footer__social-link">
                <svg class="icon icon-facebook" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M18 2H15C13.6739 2 12.4021 2.52678 11.4645 3.46447C10.5268 4.40215 10 5.67392 10 7V10H7V14H10V22H14V14H17L18 10H14V7C14 6.73478 14.1054 6.48043 14.2929 6.29289C14.4804 6.10536 14.7348 6 15 6H18V2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="visually-hidden">Facebook</span>
              </a>
            </li>
          {%- endif -%}
          
          {%- if settings.social_twitter_link != blank -%}
            <li class="footer__social-item">
              <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer" class="footer__social-link">
                <svg class="icon icon-twitter" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M23 3A10.9 10.9 0 0 1 20.1 4.8A4.48 4.48 0 0 0 22.46 2A8.91 8.91 0 0 1 20.14 3A4.48 4.48 0 0 0 15.32 1A4.52 4.52 0 0 0 10.8 5.5A12.94 12.94 0 0 1 1.64 2.16A4.48 4.48 0 0 0 3.04 8.1A4.5 4.5 0 0 1 1 7.59V7.8A4.5 4.5 0 0 0 4.6 12.1A4.5 4.5 0 0 1 1 11.44A4.5 4.5 0 0 0 5.2 15.5A9 9 0 0 1 1 17A12.9 12.9 0 0 0 8 19C16.5 19 21.17 12.5 21.17 6.8C21.17 6.6 21.17 6.4 21.16 6.21A9.18 9.18 0 0 0 23 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="visually-hidden">Twitter</span>
              </a>
            </li>
          {%- endif -%}
          
          {%- if settings.social_pinterest_link != blank -%}
            <li class="footer__social-item">
              <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer" class="footer__social-link">
                <svg class="icon icon-pinterest" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="M9 12A3 3 0 0 1 15 9C15 7.89543 14.1046 7 13 7H11C9.89543 7 9 7.89543 9 9V17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="visually-hidden">Pinterest</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Copyright -->
      <div class="footer__copyright">
        <p>&copy; {{ "now" | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer settings"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show social media links",
      "default": true,
      "info": "Social media links are configured in theme settings"
    }
  ]
}
{% endschema %} 