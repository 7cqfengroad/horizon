{% comment %}
  Main Page Section
  Basic page template for static pages
{% endcomment %}

<section class="section-page" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="page-content">
      {% if page.title != blank %}
        <h1>{{ page.title }}</h1>
      {% endif %}
      
      {% if page.content != blank %}
        <div class="page-body">
          {{ page.content }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .section-page {
    min-height: 40vh;
  }
  
  .page-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .page-content h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
    color: var(--color-base-text);
    font-family: var(--font-heading-family);
  }
  
  .page-body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-base-text);
  }
  
  .page-body h2,
  .page-body h3,
  .page-body h4 {
    font-family: var(--font-heading-family);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .page-body p {
    margin-bottom: 1.5rem;
  }
  
  .page-body a {
    color: var(--color-accent-gold);
    text-decoration: none;
  }
  
  .page-body a:hover {
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ]
}
{% endschema %} 