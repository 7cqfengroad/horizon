{% doc %}
  Three Square Layout Section

  Layout with a large media area on the left (supporting video or image with text)
  and two square images vertically stacked on the right. Used for Off-Season Collection.

  @param media_type {String} Type of media ('video' or 'image')
  @param shape_color {String} Decorative shape color
  @param background_color {String} Section background color
{% enddoc %}

{% liquid
  assign section_id = 'three-square-layout-' | append: section.id
  assign media_type = section.settings.media_type | default: 'image'
  assign video_url = section.settings.video_url
  assign video_poster = section.settings.video_poster
  assign main_image = section.settings.main_image
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign shape_color = section.settings.shape_color
  assign background_color = section.settings.background_color
%}

<section id="{{ section_id }}" class="three-square-layout">
  <div class="three-square-layout__wrapper">
    <div class="page-width">
      <div class="three-square-layout__inner">
        
        <!-- Left Content Area -->
        <div class="three-square-layout__main">
          <div class="three-square-layout__media">
            {%- if media_type == 'video' and video_url != blank -%}
              <video 
                class="three-square-layout__video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                {%- if video_poster -%}
                  poster="{{ video_poster | image_url: width: 800 }}"
                {%- endif -%}
              >
                <source src="{{ video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {%- elsif main_image -%}
              {{ main_image | image_url: width: 800 | image_tag:
                 class: 'three-square-layout__image',
                 alt: main_image.alt | escape,
                 loading: 'lazy',
                 sizes: '(max-width: 749px) 100vw, 60vw'
              }}
            {%- else -%}
              <div class="three-square-layout__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          
          <div class="three-square-layout__content">
            {%- if heading != blank -%}
              <h2 class="three-square-layout__heading h2">{{ heading | escape }}</h2>
            {%- endif -%}
            
            {%- if text != blank -%}
              <div class="three-square-layout__text rte">
                {{ text }}
              </div>
            {%- endif -%}
            
            {%- if button_text != blank and button_url != blank -%}
              <div class="three-square-layout__button">
                <a href="{{ button_url }}" class="btn btn--secondary">
                  {{ button_text | escape }}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Right Images Area -->
        <div class="three-square-layout__images">
          {%- if image_1 -%}
            <div class="three-square-layout__square three-square-layout__square--1">
              {{ image_1 | image_url: width: 400 | image_tag:
                 alt: image_1.alt | escape,
                 loading: 'lazy',
                 sizes: '(max-width: 749px) 50vw, 20vw'
              }}
            </div>
          {%- else -%}
            <div class="three-square-layout__square three-square-layout__square--1">
              <div class="three-square-layout__square-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endif -%}
          
          {%- if image_2 -%}
            <div class="three-square-layout__square three-square-layout__square--2">
              {{ image_2 | image_url: width: 400 | image_tag:
                 alt: image_2.alt | escape,
                 loading: 'lazy',
                 sizes: '(max-width: 749px) 50vw, 20vw'
              }}
            </div>
          {%- else -%}
            <div class="three-square-layout__square three-square-layout__square--2">
              <div class="three-square-layout__square-placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
    
    {%- if shape_color != blank -%}
      <div class="three-square-layout__shape" style="background-color: {{ shape_color }};"></div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #{{ section_id }} {
    {%- if background_color != blank -%}
      background-color: {{ background_color }};
    {%- endif -%}
  }

  .three-square-layout {
    position: relative;
    padding: var(--spacing-sections-mobile) 0;
    overflow: hidden;
  }

  .three-square-layout__wrapper {
    position: relative;
  }

  .three-square-layout__inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 500px;
  }

  /* Left Main Area */
  .three-square-layout__main {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 2rem;
    height: 100%;
  }

  .three-square-layout__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
  }

  .three-square-layout__video,
  .three-square-layout__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .three-square-layout__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .three-square-layout__content {
    padding: 1rem 0;
  }

  .three-square-layout__heading {
    margin-bottom: 1.5rem;
    color: var(--color-base-text);
  }

  .three-square-layout__text {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-base-text);
  }

  .three-square-layout__text p {
    margin-bottom: 1rem;
  }

  .three-square-layout__text p:last-child {
    margin-bottom: 0;
  }

  /* Right Images Area */
  .three-square-layout__images {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
    height: 100%;
    align-content: center;
  }

  .three-square-layout__square {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
  }

  .three-square-layout__square img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .three-square-layout__square:hover img {
    transform: scale(1.05);
  }

  .three-square-layout__square-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Decorative Shape */
  .three-square-layout__shape {
    position: absolute;
    top: 10%;
    right: -15%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    opacity: 0.08;
    z-index: 0;
  }

  /* Mobile Styles */
  @media screen and (max-width: 749px) {
    .three-square-layout {
      padding: var(--spacing-sections-mobile) 0;
    }

    .three-square-layout__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: auto;
    }

    .three-square-layout__main {
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .three-square-layout__media {
      aspect-ratio: 16 / 9;
    }

    .three-square-layout__images {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      gap: 1rem;
    }

    .three-square-layout__shape {
      width: 200px;
      height: 200px;
      top: 5%;
      right: -25%;
    }
  }

  /* Tablet Styles */
  @media screen and (min-width: 750px) and (max-width: 999px) {
    .three-square-layout__inner {
      gap: 2rem;
    }

    .three-square-layout__images {
      gap: 1rem;
    }
  }

  /* Desktop Styles */
  @media screen and (min-width: 1000px) {
    .three-square-layout {
      padding: var(--spacing-sections-desktop) 0;
    }

    .three-square-layout__inner {
      gap: 4rem;
    }
  }

  /* Video Controls */
  .three-square-layout__video {
    cursor: pointer;
  }

  .three-square-layout__video:hover {
    opacity: 0.9;
  }

  /* Prevent motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    .three-square-layout__square img {
      transition: none;
    }

    .three-square-layout__square:hover img {
      transform: none;
    }

    .three-square-layout__video {
      animation-play-state: paused;
    }
  }
{% endstyle %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const videos = document.querySelectorAll('.three-square-layout__video');
  
  videos.forEach(video => {
    // Handle video click to play/pause
    video.addEventListener('click', function() {
      if (this.paused) {
        this.play();
      } else {
        this.pause();
      }
    });

    // Ensure videos play on load
    video.addEventListener('loadedmetadata', function() {
      this.play().catch(e => {
        console.log('Video autoplay failed:', e);
      });
    });

    // Handle video errors
    video.addEventListener('error', function() {
      console.log('Video failed to load');
      this.style.display = 'none';
    });
  });

  // Pause videos when user prefers reduced motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    videos.forEach(video => {
      video.pause();
    });
  }
});
</script>

{% schema %}
{
  "name": "Three Square Layout",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Main Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Upload video to Files section and paste URL here"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "header",
      "content": "Square Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Square Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Square Image 2"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Off-Season Collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are delighted to introduce the Off-Season Collection - over a dozen new archival pieces that we feel captures this paradox of American style.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "shape_color",
      "label": "Shape Color",
      "info": "Decorative background shape",
      "default": "#934c4c"
    }
  ],
  "presets": [
    {
      "name": "Three Square Layout",
      "settings": {
        "heading": "The Off-Season Collection",
        "text": "<p>We are delighted to introduce the Off-Season Collection - over a dozen new archival pieces that we feel captures this paradox of American style.</p>",
        "button_text": "View",
        "shape_color": "#934c4c"
      }
    }
  ]
}
{% endschema %} 