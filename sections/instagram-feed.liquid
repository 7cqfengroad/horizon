{% comment %}
  Instagram Feed Section
  Used to display Instagram posts in a grid layout
  
  Features:
  - Grid layout of Instagram images
  - Customizable number of posts
  - Links to Instagram profile and individual posts
  - Responsive design with mobile adaptation
  - Lazy loading for images
{% endcomment %}

{% liquid
  assign section_id = 'InstagramFeed-' | append: section.id
  assign posts_to_show = section.settings.posts_to_show | default: 4
%}

<section
  id="{{ section_id }}"
  class="instagram-feed color-scheme-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="instagram-feed__container{% if section.settings.full_width %} instagram-feed__container--full-width{% else %} page-width{% endif %}">
    
    {% if section.settings.heading != blank %}
      <div class="instagram-feed__header">
        {% if section.settings.instagram_url != blank %}
          <h2 class="instagram-feed__heading">
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="instagram-feed__heading-link">
              {{ section.settings.heading | escape }}
            </a>
          </h2>
        {% else %}
          <h2 class="instagram-feed__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="instagram-feed__grid">
      {% for block in section.blocks limit: posts_to_show %}
        {% case block.type %}
          {% when 'instagram_post' %}
            <div class="instagram-feed__item" {{ block.shopify_attributes }}>
              {% if block.settings.post_url != blank %}
                <a href="{{ block.settings.post_url }}" target="_blank" rel="noopener noreferrer" class="instagram-feed__link">
              {% endif %}
              
              <div class="instagram-feed__image-wrapper">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: 
                    class: 'instagram-feed__image', 
                    alt: block.settings.alt_text | default: 'Instagram post' | escape,
                    loading: 'lazy'
                  }}
                {% else %}
                  <div class="instagram-feed__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'instagram-feed__placeholder-image' }}
                  </div>
                {% endif %}

                <!-- Instagram overlay icon -->
                <div class="instagram-feed__overlay">
                  <div class="instagram-feed__overlay-content">
                    {% render 'icon-instagram' %}
                  </div>
                </div>
              </div>

              {% if block.settings.post_url != blank %}
                </a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}

      <!-- Fill empty slots if needed -->
      {% assign empty_slots = posts_to_show | minus: section.blocks.size %}
      {% if empty_slots > 0 %}
        {% for i in (1..empty_slots) %}
          <div class="instagram-feed__item instagram-feed__item--placeholder">
            <div class="instagram-feed__image-wrapper">
              <div class="instagram-feed__placeholder">
                {{ 'image' | placeholder_svg_tag: 'instagram-feed__placeholder-image' }}
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.instagram_url != blank and section.settings.show_follow_button %}
      <div class="instagram-feed__footer">
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="button button--primary instagram-feed__follow-button">
          {{ section.settings.follow_button_text | default: 'Follow us on Instagram' | escape }}
        </a>
      </div>
    {% endif %}
    
  </div>
</section>

{% stylesheet %}
.instagram-feed {
  padding-top: var(--section-padding-top, 50px);
  padding-bottom: var(--section-padding-bottom, 50px);
}

.instagram-feed__container--full-width {
  max-width: none;
  padding-left: 2rem;
  padding-right: 2rem;
}

.instagram-feed__header {
  text-align: center;
  margin-bottom: 4rem;
}

.instagram-feed__heading {
  font-size: 3.6rem;
  text-transform: uppercase;
  letter-spacing: 0.2rem;
  margin: 0;
  color: rgba(var(--color-base-text), 0.85);
}

.instagram-feed__heading-link {
  color: inherit;
  text-decoration: none;
  transition: color var(--duration-short) ease;
}

.instagram-feed__heading-link:hover {
  color: rgba(var(--color-base-text), 1);
}

.instagram-feed__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.instagram-feed__item {
  position: relative;
  aspect-ratio: 1;
}

.instagram-feed__item--placeholder {
  opacity: 0.3;
}

.instagram-feed__link {
  display: block;
  width: 100%;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.instagram-feed__image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: rgba(var(--color-base-text), 0.04);
  border-radius: 0.5rem;
}

.instagram-feed__image,
.instagram-feed__placeholder-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--duration-long) ease;
}

.instagram-feed__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(var(--color-base-text), 0.04);
}

.instagram-feed__placeholder-image {
  width: 50%;
  height: 50%;
  opacity: 0.3;
}

.instagram-feed__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--duration-default) ease;
  border-radius: 0.5rem;
}

.instagram-feed__item:hover .instagram-feed__overlay {
  opacity: 1;
}

.instagram-feed__item:hover .instagram-feed__image {
  transform: scale(1.05);
}

.instagram-feed__overlay-content {
  color: #ffffff;
}

.instagram-feed__overlay-content .icon {
  width: 3rem;
  height: 3rem;
}

.instagram-feed__footer {
  text-align: center;
  margin-top: 4rem;
}

.instagram-feed__follow-button {
  font-size: 1.6rem;
  padding: 1.5rem 3rem;
}

/* Tablet styles */
@media screen and (min-width: 750px) and (max-width: 1199px) {
  .instagram-feed__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .instagram-feed__heading {
    font-size: 3rem;
  }

  .instagram-feed__header {
    margin-bottom: 3rem;
  }

  .instagram-feed__footer {
    margin-top: 3rem;
  }
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .instagram-feed__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .instagram-feed__heading {
    font-size: 2.4rem;
  }

  .instagram-feed__header {
    margin-bottom: 2rem;
  }

  .instagram-feed__footer {
    margin-top: 2rem;
  }

  .instagram-feed__overlay-content .icon {
    width: 2.5rem;
    height: 2.5rem;
  }

  .instagram-feed__follow-button {
    font-size: 1.4rem;
    padding: 1.2rem 2.5rem;
  }
}

/* Print styles */
@media print {
  .instagram-feed__overlay {
    display: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find us on Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL",
      "info": "Link to your Instagram profile"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": " posts",
      "label": "Number of posts to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Follow button"
    },
    {
      "type": "checkbox",
      "id": "show_follow_button",
      "label": "Show follow button",
      "default": false
    },
    {
      "type": "text",
      "id": "follow_button_text",
      "label": "Follow button text",
      "default": "Follow us on Instagram"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Description of the image for accessibility"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Instagram post URL",
          "info": "Link to the Instagram post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        }
      ]
    }
  ]
}
{% endschema %} 