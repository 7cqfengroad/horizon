{% doc %}
  Instagram Feed Section

  Displays Instagram posts in a grid layout with a title that links to the Instagram profile.
  Used to showcase brand's Instagram content on the website.

  @param heading {String} Section heading
  @param instagram_url {String} Instagram profile URL
  @param posts_per_row {Number} Number of posts per row
{% enddoc %}

{% liquid
  assign section_id = 'instagram-feed-' | append: section.id
  assign heading = section.settings.heading
  assign instagram_url = section.settings.instagram_url
  assign posts_per_row = section.settings.posts_per_row | default: 4
  assign background_color = section.settings.background_color
%}

<section id="{{ section_id }}" class="instagram-feed">
  <div class="page-width">
    <div class="instagram-feed__wrapper">
      
      {%- if heading != blank -%}
        <div class="instagram-feed__header">
          {%- if instagram_url != blank -%}
            <h2 class="instagram-feed__heading">
              <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="instagram-feed__heading-link">
                {{ heading | escape }}
              </a>
            </h2>
          {%- else -%}
            <h2 class="instagram-feed__heading">{{ heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="instagram-feed__grid instagram-feed__grid--{{ posts_per_row }}-per-row">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'instagram_post' -%}
                {%- liquid
                  assign post_image = block.settings.image
                  assign post_url = block.settings.post_url
                  assign alt_text = block.settings.alt_text | default: 'Instagram post'
                -%}
                
                {%- if post_image -%}
                  <div class="instagram-feed__post" {{ block.shopify_attributes }}>
                    {%- if post_url != blank -%}
                      <a 
                        href="{{ post_url }}" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="instagram-feed__post-link"
                        aria-label="{{ 'sections.instagram_feed.view_post' | t }}"
                      >
                    {%- endif -%}
                    
                    <div class="instagram-feed__post-media">
                      {{ post_image | image_url: width: 600 | image_tag:
                         class: 'instagram-feed__post-image',
                         alt: alt_text | escape,
                         loading: 'lazy',
                         sizes: '(max-width: 599px) 50vw, (max-width: 999px) 33vw, 25vw'
                      }}
                      
                      <div class="instagram-feed__post-overlay">
                        <div class="instagram-feed__post-icon">
                          {%- render 'icon', icon: 'instagram' -%}
                        </div>
                      </div>
                    </div>
                    
                    {%- if post_url != blank -%}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
        
        {%- if instagram_url != blank -%}
          <div class="instagram-feed__footer">
            <a 
              href="{{ instagram_url }}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn--secondary instagram-feed__follow-btn"
            >
              {{ 'sections.instagram_feed.follow_us' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="instagram-feed__empty">
          <p>{{ 'sections.instagram_feed.no_posts' | t }}</p>
          {%- if instagram_url != blank -%}
            <a 
              href="{{ instagram_url }}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              {{ 'sections.instagram_feed.visit_instagram' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% style %}
  #{{ section_id }} {
    {%- if background_color != blank -%}
      background-color: {{ background_color }};
    {%- endif -%}
  }

  .instagram-feed {
    padding: var(--spacing-sections-mobile) 0;
  }

  .instagram-feed__wrapper {
    text-align: center;
  }

  .instagram-feed__header {
    margin-bottom: 3rem;
  }

  .instagram-feed__heading {
    margin: 0;
    color: var(--color-base-text);
    font-size: 2rem;
    font-weight: 400;
  }

  .instagram-feed__heading-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .instagram-feed__heading-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .instagram-feed__heading-link:hover {
    color: var(--color-base-accent-1);
  }

  .instagram-feed__heading-link:hover::after {
    transform: scaleX(1);
  }

  /* Grid Layout */
  .instagram-feed__grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .instagram-feed__grid--2-per-row {
    grid-template-columns: repeat(2, 1fr);
  }

  .instagram-feed__grid--3-per-row {
    grid-template-columns: repeat(3, 1fr);
  }

  .instagram-feed__grid--4-per-row {
    grid-template-columns: repeat(4, 1fr);
  }

  .instagram-feed__grid--5-per-row {
    grid-template-columns: repeat(5, 1fr);
  }

  /* Post Styling */
  .instagram-feed__post {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 1 / 1;
  }

  .instagram-feed__post-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .instagram-feed__post-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .instagram-feed__post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .instagram-feed__post:hover .instagram-feed__post-image {
    transform: scale(1.05);
  }

  /* Overlay */
  .instagram-feed__post-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .instagram-feed__post:hover .instagram-feed__post-overlay {
    opacity: 1;
  }

  .instagram-feed__post-icon {
    color: white;
    font-size: 2rem;
  }

  .instagram-feed__post-icon svg {
    width: 2rem;
    height: 2rem;
  }

  /* Footer */
  .instagram-feed__footer {
    margin-top: 2rem;
  }

  .instagram-feed__follow-btn {
    min-width: 200px;
  }

  /* Empty State */
  .instagram-feed__empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-base-text);
  }

  .instagram-feed__empty p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
    opacity: 0.7;
  }

  /* Mobile Styles */
  @media screen and (max-width: 599px) {
    .instagram-feed {
      padding: var(--spacing-sections-mobile) 0;
    }

    .instagram-feed__header {
      margin-bottom: 2rem;
    }

    .instagram-feed__heading {
      font-size: 1.5rem;
    }

    .instagram-feed__grid {
      gap: 0.75rem;
    }

    .instagram-feed__grid--3-per-row,
    .instagram-feed__grid--4-per-row,
    .instagram-feed__grid--5-per-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .instagram-feed__post-icon {
      font-size: 1.5rem;
    }

    .instagram-feed__post-icon svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  /* Tablet Styles */
  @media screen and (min-width: 600px) and (max-width: 999px) {
    .instagram-feed__grid--4-per-row,
    .instagram-feed__grid--5-per-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Desktop Styles */
  @media screen and (min-width: 1000px) {
    .instagram-feed {
      padding: var(--spacing-sections-desktop) 0;
    }

    .instagram-feed__header {
      margin-bottom: 4rem;
    }

    .instagram-feed__grid {
      gap: 1.5rem;
    }
  }

  /* Focus and accessibility */
  .instagram-feed__heading-link:focus-visible,
  .instagram-feed__post-link:focus-visible,
  .instagram-feed__follow-btn:focus-visible {
    outline: 2px solid var(--color-base-accent-1);
    outline-offset: 2px;
  }

  /* Prevent motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    .instagram-feed__post-image {
      transition: none;
    }

    .instagram-feed__post:hover .instagram-feed__post-image {
      transform: none;
    }

    .instagram-feed__post-overlay,
    .instagram-feed__heading-link::after {
      transition: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: more) {
    .instagram-feed__post {
      border: 2px solid var(--color-base-text);
    }

    .instagram-feed__post-overlay {
      background: rgba(0, 0, 0, 0.8);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find us on Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL",
      "default": "https://www.instagram.com/verdurajewelry/",
      "info": "Link to your Instagram profile"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "posts_per_row",
      "label": "Posts per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Number of posts to display per row on desktop"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Instagram Post URL",
          "info": "Link to the specific Instagram post"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text",
          "info": "Describe the image for screen readers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "settings": {
        "heading": "Find us on Instagram",
        "instagram_url": "https://www.instagram.com/verdurajewelry/",
        "posts_per_row": 4
      },
      "blocks": [
        {
          "type": "instagram_post",
          "settings": {
            "alt_text": "Instagram post 1"
          }
        },
        {
          "type": "instagram_post",
          "settings": {
            "alt_text": "Instagram post 2"
          }
        },
        {
          "type": "instagram_post",
          "settings": {
            "alt_text": "Instagram post 3"
          }
        },
        {
          "type": "instagram_post",
          "settings": {
            "alt_text": "Instagram post 4"
          }
        }
      ]
    }
  ]
}
{% endschema %} 