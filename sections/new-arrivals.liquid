{{ 'new-arrivals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show | default: 4
  assign enable_quick_add = section.settings.enable_quick_add
-%}

<section class="new-arrivals section-padding">
  <div class="container">
    
    {%- if heading != blank -%}
      <div class="section-header">
        <h2 class="section-heading h2">{{ heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="new-arrivals__products">
      
      {%- if collection and collection.products.size > 0 -%}
        <div class="new-arrivals__grid grid grid--4-col-desktop grid--2-col-tablet grid--1-col-mobile">
          
          {%- for product in collection.products limit: products_to_show -%}
            <div class="new-arrivals__product-item grid__item">
              <div class="product-card">
                
                <div class="product-card__media">
                  <a href="{{ product.url }}" class="product-card__link">
                    {%- if product.featured_media -%}
                      <img 
                        src="{{ product.featured_media | image_url: width: 400 }}"
                        alt="{{ product.featured_media.alt | default: product.title | escape }}"
                        width="400"
                        height="400"
                        class="product-card__image"
                        loading="lazy"
                      >
                    {%- else -%}
                      <div class="product-card__placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </a>
                  
                  {%- if enable_quick_add and product.available -%}
                    <div class="product-card__actions">
                      <button 
                        type="button" 
                        class="product-card__quick-add btn btn--secondary btn--small"
                        data-product-id="{{ product.id }}"
                        aria-label="Quick add {{ product.title | escape }}"
                      >
                        Quick Add
                      </button>
                    </div>
                  {%- endif -%}
                </div>

                <div class="product-card__info">
                  <h3 class="product-card__title">
                    <a href="{{ product.url }}" class="product-card__title-link">
                      {{ product.title | escape }}
                    </a>
                  </h3>
                  
                  <div class="product-card__price">
                    {%- render 'price', product: product, use_variant: true, show_badges: true -%}
                  </div>
                </div>

              </div>
            </div>
          {%- endfor -%}
          
        </div>
      {%- else -%}
        <!-- Placeholder when no collection is selected -->
        <div class="new-arrivals__placeholder">
          <div class="new-arrivals__grid grid grid--4-col-desktop grid--2-col-tablet grid--1-col-mobile">
            {%- for i in (1..4) -%}
              <div class="new-arrivals__product-item grid__item">
                <div class="product-card">
                  <div class="product-card__media">
                    <div class="product-card__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  </div>
                  <div class="product-card__info">
                    <h3 class="product-card__title">New Product {{ i }}</h3>
                    <div class="product-card__price">$0.00</div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section", 
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %} 