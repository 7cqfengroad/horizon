{% comment %} New Arrivals Section {% endcomment %}
<section class="new-arrivals" style="padding: 80px 0; background: white;">
  <div class="container">
    
    {% comment %} Section Title {% endcomment %}
    {% if section.settings.title != blank %}
      <h2 class="h1" style="font-family: var(--font-heading-family); font-size: 3rem; font-weight: 400; text-align: center; margin-bottom: 60px; color: {{ section.settings.text_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% comment %} Product Slider {% endcomment %}
    <div class="product-slider" style="position: relative;">
      
      {% comment %} Products Grid {% endcomment %}
      <div class="products-container" style="overflow: hidden;">
        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; transition: transform 0.3s ease;">
          
          {% comment %} Products from collection or manual selection {% endcomment %}
          {% if section.settings.collection != blank %}
            {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
              <div class="product-card" style="text-align: center;">
                <a href="{{ product.url }}" style="text-decoration: none; color: var(--color-primary);">
                  
                  {% comment %} Product Image {% endcomment %}
                  {% if product.featured_media %}
                    <div class="product-image" style="position: relative; overflow: hidden; margin-bottom: 20px; aspect-ratio: 1;">
                      <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
                      
                      {% comment %} Hover Image {% endcomment %}
                      {% if product.media[1] %}
                        <img src="{{ product.media[1] | image_url: width: 400 }}" alt="{{ product.title }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s ease;" class="hover-image">
                      {% endif %}
                    </div>
                  {% else %}
                    <div style="aspect-ratio: 1; background: #f5f5f5; margin-bottom: 20px; display: flex; align-items: center; justify-content: center;">
                      <span style="color: #999;">No Image</span>
                    </div>
                  {% endif %}

                  {% comment %} Product Info {% endcomment %}
                  <div class="product-info">
                    <h3 style="font-family: var(--font-heading-family); font-size: 1.2rem; font-weight: 400; margin-bottom: 10px; color: {{ section.settings.text_color }};">
                      {{ product.title }}
                    </h3>
                    
                    {% if section.settings.show_price %}
                      <p style="font-size: 1rem; color: {{ section.settings.price_color }}; margin: 0;">
                        {% if product.compare_at_price > product.price %}
                          <span style="text-decoration: line-through; opacity: 0.6;">{{ product.compare_at_price | money }}</span>
                          <span style="margin-left: 10px;">{{ product.price | money }}</span>
                        {% else %}
                          {{ product.price | money }}
                        {% endif %}
                      </p>
                    {% endif %}
                  </div>
                </a>
              </div>
            {% endfor %}
          
          {% else %}
            {% comment %} Manual product blocks {% endcomment %}
            {% for block in section.blocks %}
              {% if block.type == 'product' and block.settings.product != blank %}
                {% assign product = block.settings.product %}
                <div class="product-card" style="text-align: center;">
                  <a href="{{ product.url }}" style="text-decoration: none; color: var(--color-primary);">
                    
                    {% if product.featured_media %}
                      <div class="product-image" style="position: relative; overflow: hidden; margin-bottom: 20px; aspect-ratio: 1;">
                        <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
                        
                        {% if product.media[1] %}
                          <img src="{{ product.media[1] | image_url: width: 400 }}" alt="{{ product.title }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s ease;" class="hover-image">
                        {% endif %}
                      </div>
                    {% else %}
                      <div style="aspect-ratio: 1; background: #f5f5f5; margin-bottom: 20px; display: flex; align-items: center; justify-content: center;">
                        <span style="color: #999;">No Image</span>
                      </div>
                    {% endif %}

                    <div class="product-info">
                      <h3 style="font-family: var(--font-heading-family); font-size: 1.2rem; font-weight: 400; margin-bottom: 10px; color: {{ section.settings.text_color }};">
                        {{ product.title }}
                      </h3>
                      
                      {% if section.settings.show_price %}
                        <p style="font-size: 1rem; color: {{ section.settings.price_color }}; margin: 0;">
                          {% if product.compare_at_price > product.price %}
                            <span style="text-decoration: line-through; opacity: 0.6;">{{ product.compare_at_price | money }}</span>
                            <span style="margin-left: 10px;">{{ product.price | money }}</span>
                          {% else %}
                            {{ product.price | money }}
                          {% endif %}
                        </p>
                      {% endif %}
                    </div>
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% comment %} Navigation Arrows {% endcomment %}
      {% if section.settings.show_arrows %}
        <button class="slider-prev" style="position: absolute; left: -50px; top: 50%; transform: translateY(-50%); background: white; border: 1px solid #ddd; width: 40px; height: 40px; cursor: pointer; z-index: 10; opacity: 0.8; transition: opacity 0.3s ease;">
          ‹
        </button>
        <button class="slider-next" style="position: absolute; right: -50px; top: 50%; transform: translateY(-50%); background: white; border: 1px solid #ddd; width: 40px; height: 40px; cursor: pointer; z-index: 10; opacity: 0.8; transition: opacity 0.3s ease;">
          ›
        </button>
      {% endif %}
    </div>

    {% comment %} View All Button {% endcomment %}
    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <div style="text-align: center; margin-top: 50px;">
        <a href="{{ section.settings.button_link }}" class="btn" style="display: inline-block; padding: 15px 30px; border: 2px solid {{ section.settings.text_color }}; color: {{ section.settings.text_color }}; text-decoration: none; font-weight: 500; transition: all 0.3s ease; background: transparent;">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .product-card:hover .product-image img:first-child {
    transform: scale(1.05);
  }

  .product-card:hover .hover-image {
    opacity: 1;
  }

  .slider-prev:hover,
  .slider-next:hover {
    opacity: 1;
    background: #f5f5f5;
  }

  .btn:hover {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background_color | default: 'white' }};
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 20px !important;
    }
    
    .slider-prev,
    .slider-next {
      display: none !important;
    }
    
    .new-arrivals h2 {
      font-size: 2rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const prevBtn = document.querySelector('.slider-prev');
    const nextBtn = document.querySelector('.slider-next');
    const productsGrid = document.querySelector('.products-grid');
    
    if (prevBtn && nextBtn && productsGrid) {
      let currentOffset = 0;
      const cardWidth = 290; // approximate width including gap
      
      prevBtn.addEventListener('click', function() {
        currentOffset = Math.min(currentOffset + cardWidth, 0);
        productsGrid.style.transform = `translateX(${currentOffset}px)`;
      });
      
      nextBtn.addEventListener('click', function() {
        const maxOffset = -(productsGrid.scrollWidth - productsGrid.parentElement.offsetWidth);
        currentOffset = Math.max(currentOffset - cardWidth, maxOffset);
        productsGrid.style.transform = `translateX(${currentOffset}px)`;
      });
    }
  });
</script>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "New Arrivals",
      "settings": {
        "title": "New Arrivals"
      }
    }
  ]
}
{% endschema %}