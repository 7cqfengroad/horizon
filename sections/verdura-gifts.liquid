 → {% comment %}
  Verdura Gifts Section
  复刻 "Very Verdura - Gifts Under $20,000" 展示区域
{% endcomment %}

{%- liquid
  assign gifts_collection = collections[section.settings.gifts_collection] | default: collections['very-verdura-gifts-under-15-000'] | default: collections.all
-%}

<section class="gifts-section" id="gifts">
  <div class="page-width">
    <div class="gifts-section__wrapper">
      
      <div class="gifts-section__content">
        <!-- Left Product Image -->
        <div class="gifts-section__product gifts-section__product--left">
          {% if gifts_collection.products.size > 0 %}
            {% assign left_product = gifts_collection.products[0] %}
            <div class="gifts-product">
              <a href="{{ left_product.url }}" class="gifts-product__link">
                {% if left_product.featured_image %}
                  <img src="{{ left_product.featured_image | image_url: width: 400 }}" 
                       alt="{{ left_product.title | escape }}"
                       class="gifts-product__image"
                       loading="lazy">
                {% endif %}
              </a>
            </div>
          {% else %}
            <div class="gifts-product">
              <img src="https://ext.same-assets.com/3425221127/89074985.png" 
                   alt="Very Verdura Gift"
                   class="gifts-product__image"
                   loading="lazy">
            </div>
          {% endif %}
        </div>

        <!-- Center Content -->
        <div class="gifts-section__center">
          <div class="gifts-section__text">
            <h2 class="gifts-section__title">
              {% if section.settings.gifts_title_line1 != blank %}
                <span class="title-line title-line--1">{{ section.settings.gifts_title_line1 }}</span>
              {% else %}
                <span class="title-line title-line--1">Very</span>
              {% endif %}
              
              {% if section.settings.gifts_title_line2 != blank %}
                <span class="title-line title-line--2">{{ section.settings.gifts_title_line2 }}</span>
              {% else %}
                <span class="title-line title-line--2">Verdura</span>
              {% endif %}
            </h2>
            
            <h3 class="gifts-section__subtitle h3">
              {% if section.settings.gifts_subtitle != blank %}
                {{ section.settings.gifts_subtitle }}
              {% else %}
                GIFTS UNDER $20,000
              {% endif %}
            </h3>
            
            <div class="gifts-section__description">
              {% if section.settings.gifts_description != blank %}
                <p>{{ section.settings.gifts_description }}</p>
              {% else %}
                <p>A collection of pieces perfect for gifting and receiving</p>
              {% endif %}
            </div>
            
            <a href="{{ gifts_collection.url }}" class="gifts-section__link">
              {% if section.settings.gifts_link_text != blank %}
                {{ section.settings.gifts_link_text }}
              {% else %}
                SHOP
              {% endif %}
            </a>
          </div>
        </div>

        <!-- Right Product Image -->
        <div class="gifts-section__product gifts-section__product--right">
          {% if gifts_collection.products.size > 1 %}
            {% assign right_product = gifts_collection.products[1] %}
            <div class="gifts-product">
              <a href="{{ right_product.url }}" class="gifts-product__link">
                {% if right_product.featured_image %}
                  <img src="{{ right_product.featured_image | image_url: width: 400 }}" 
                       alt="{{ right_product.title | escape }}"
                       class="gifts-product__image"
                       loading="lazy">
                {% endif %}
              </a>
            </div>
          {% else %}
            <div class="gifts-product">
              <img src="https://ext.same-assets.com/3425221127/1122959255.jpeg" 
                   alt="Very Verdura Gift"
                   class="gifts-product__image"
                   loading="lazy">
            </div>
          {% endif %}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .gifts-section {
    padding: 120px 0;
    background: var(--color-base-background-1);
    position: relative;
    overflow: hidden;
  }

  .gifts-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at center, 
      rgba(196, 157, 87, 0.03) 0%, 
      transparent 50%);
    pointer-events: none;
  }

  .gifts-section__wrapper {
    position: relative;
    z-index: 2;
  }

  .gifts-section__content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 80px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .gifts-section__product {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .gifts-product {
    position: relative;
    transition: transform 0.4s ease;
  }

  .gifts-product:hover {
    transform: translateY(-12px) scale(1.02);
  }

  .gifts-product__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gifts-product__image {
    width: 100%;
    height: auto;
    max-width: 280px;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.1));
    transition: filter 0.4s ease;
  }

  .gifts-product:hover .gifts-product__image {
    filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.15));
  }

  .gifts-section__center {
    text-align: center;
    max-width: 400px;
    padding: 40px 0;
  }

  .gifts-section__title {
    font-family: var(--font-heading-family);
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: -5px;
  }

  .title-line {
    display: block;
    line-height: 0.9;
    letter-spacing: 0.02em;
  }

  .title-line--1 {
    font-size: 3.5rem;
    font-weight: 400;
    color: var(--color-base-text);
    font-style: italic;
  }

  .title-line--2 {
    font-size: 4rem;
    font-weight: 500;
    color: var(--color-base-text);
    margin-top: -8px;
  }

  .gifts-section__subtitle {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-base-text);
    margin-bottom: 30px;
    opacity: 0.8;
  }

  .gifts-section__description {
    margin-bottom: 40px;
  }

  .gifts-section__description p {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-base-text);
    margin: 0;
  }

  .gifts-section__link {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-base-text);
    transition: color 0.3s ease;
    display: inline-block;
  }

  .gifts-section__link:hover {
    color: var(--color-accent-gold);
  }

  /* Floating animation for products */
  .gifts-section__product--left .gifts-product {
    animation: floatGiftLeft 8s ease-in-out infinite;
  }

  .gifts-section__product--right .gifts-product {
    animation: floatGiftRight 8s ease-in-out infinite;
    animation-delay: 4s;
  }

  @keyframes floatGiftLeft {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-8px) rotate(1deg);
    }
    50% {
      transform: translateY(-4px) rotate(0deg);
    }
    75% {
      transform: translateY(-12px) rotate(-1deg);
    }
  }

  @keyframes floatGiftRight {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-6px) rotate(-1deg);
    }
    50% {
      transform: translateY(-10px) rotate(0deg);
    }
    75% {
      transform: translateY(-4px) rotate(1deg);
    }
  }

  /* Mobile Responsive */
  @media screen and (max-width: 1024px) {
    .gifts-section__content {
      gap: 60px;
    }

    .gifts-product__image {
      max-width: 240px;
    }

    .title-line--1 {
      font-size: 3rem;
    }

    .title-line--2 {
      font-size: 3.5rem;
    }
  }

  @media screen and (max-width: 768px) {
    .gifts-section {
      padding: 80px 0;
    }

    .gifts-section__content {
      display: block;
      text-align: center;
    }

    .gifts-section__center {
      max-width: 100%;
      margin: 40px 0;
      order: 1;
    }

    .gifts-section__product--left {
      order: 2;
      margin-bottom: 30px;
    }

    .gifts-section__product--right {
      order: 3;
    }

    .gifts-product__image {
      max-width: 200px;
    }

    .title-line--1 {
      font-size: 2.5rem;
    }

    .title-line--2 {
      font-size: 3rem;
    }

    .gifts-section__subtitle {
      font-size: 1.2rem;
    }

    .gifts-section__description p {
      font-size: 15px;
    }

    /* Disable animations on mobile */
    .gifts-section__product--left .gifts-product,
    .gifts-section__product--right .gifts-product {
      animation: none;
    }
  }

  @media screen and (max-width: 480px) {
    .title-line--1 {
      font-size: 2rem;
    }

    .title-line--2 {
      font-size: 2.5rem;
    }

    .gifts-section__subtitle {
      font-size: 1rem;
    }

    .gifts-product__image {
      max-width: 160px;
    }

    .gifts-section__description p {
      font-size: 14px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gifts-section__product--left .gifts-product,
    .gifts-section__product--right .gifts-product {
      animation: none;
    }

    .gifts-product {
      transition: none;
    }

    .gifts-product__image {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Very Verdura Gifts",
  "settings": [
    {
      "type": "collection",
      "id": "gifts_collection",
      "label": "Gifts Collection",
      "info": "Select the gifts collection to display"
    },
    {
      "type": "text",
      "id": "gifts_title_line1",
      "label": "Title Line 1",
      "default": "Very"
    },
    {
      "type": "text",
      "id": "gifts_title_line2",
      "label": "Title Line 2",
      "default": "Verdura"
    },
    {
      "type": "text",
      "id": "gifts_subtitle",
      "label": "Section Subtitle",
      "default": "GIFTS UNDER $20,000"
    },
    {
      "type": "textarea",
      "id": "gifts_description",
      "label": "Section Description",
      "default": "A collection of pieces perfect for gifting and receiving"
    },
    {
      "type": "text",
      "id": "gifts_link_text",
      "label": "Link Text",
      "default": "SHOP"
    }
  ],
  "presets": [
    {
      "name": "Very Verdura Gifts"
    }
  ]
}
{% endschema %}