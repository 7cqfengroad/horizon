{{ 'zodiac-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign description = section.settings.description
  assign collection = collections[section.settings.collection]
  assign button_text = section.settings.button_text
  assign background_color = section.settings.background_color
  assign max_products = section.settings.max_products | default: 2
-%}

<section class="zodiac-collection section-padding" 
         style="--bg-color: {{ background_color | default: '#f8f5f0' }};">
  <div class="container">
    <div class="zodiac-collection__inner">
      
      <!-- Content Side -->
      <div class="zodiac-collection__content">
        
        {%- if heading != blank -%}
          <h2 class="zodiac-collection__heading h2">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if subheading != blank -%}
          <p class="zodiac-collection__subheading">{{ subheading | escape }}</p>
        {%- endif -%}

        {%- if description != blank -%}
          <div class="zodiac-collection__description">
            <p>{{ description | escape }}</p>
          </div>
        {%- endif -%}

        {%- if button_text != blank and collection -%}
          <div class="zodiac-collection__actions">
            <a href="{{ collection.url }}" class="zodiac-collection__button btn btn--primary">
              {{ button_text | escape }}
            </a>
          </div>
        {%- endif -%}

      </div>

      <!-- Products Side -->
      <div class="zodiac-collection__products">
        
        {%- if collection and collection.products.size > 0 -%}
          <div class="zodiac-collection__grid">
            
            {%- for product in collection.products limit: max_products -%}
              <div class="zodiac-collection__product-item">
                <div class="product-card">
                  
                  <div class="product-card__media">
                    <a href="{{ product.url }}" class="product-card__link">
                      {%- if product.featured_media -%}
                        <img 
                          src="{{ product.featured_media | image_url: width: 400 }}"
                          alt="{{ product.featured_media.alt | default: product.title | escape }}"
                          width="400"
                          height="400"
                          class="product-card__image"
                          loading="lazy"
                        >
                      {%- else -%}
                        <div class="product-card__placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="product-card__info">
                    <h3 class="product-card__title">
                      <a href="{{ product.url }}" class="product-card__title-link">
                        {{ product.title | escape }}
                      </a>
                    </h3>
                    
                    <div class="product-card__price">
                      {%- render 'price', product: product, use_variant: true, show_badges: false -%}
                    </div>
                  </div>

                </div>
              </div>
            {%- endfor -%}
            
          </div>
        {%- else -%}
          <!-- Placeholder when no collection is selected -->
          <div class="zodiac-collection__placeholder">
            <div class="zodiac-collection__grid">
              {%- for i in (1..2) -%}
                <div class="zodiac-collection__product-item">
                  <div class="product-card">
                    <div class="product-card__media">
                      <div class="product-card__placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    </div>
                    <div class="product-card__info">
                      <h3 class="product-card__title">Zodiac Necklace {{ i }}</h3>
                      <div class="product-card__price">$0.00</div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zodiac Collection",
  "tag": "section", 
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zodiac"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "BESPOKE NECKLACES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our exquisite Zodiac necklaces capture the essence of your astrological sign. Each piece is meticulously handcrafted with the finest materials and features intricate details that reflect the unique characteristics of your celestial identity."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "VIEW ZODIAC"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Maximum products to show",
      "default": 2
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f5f0"
    }
  ],
  "presets": [
    {
      "name": "Zodiac Collection"
    }
  ]
}
{% endschema %} 