{% comment %}
  Product Slider Section
  Used for New Arrivals and featured product showcases
  
  Features:
  - Horizontal scrolling product cards
  - Left/right navigation arrows
  - Product hover effects with title display
  - Responsive design with different cards shown per view
  - Auto-scroll functionality (optional)
{% endcomment %}

{% liquid
  assign section_id = 'ProductSlider-' | append: section.id
  assign collection = collections[section.settings.collection] | default: collections.all
  assign products_to_show = section.settings.products_to_show | default: 8
  assign slide_speed = section.settings.slide_speed | default: 5000
%}

<section
  id="{{ section_id }}"
  class="product-slider color-scheme-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.heading != blank %}
    <div class="product-slider__header page-width">
      <h2 class="product-slider__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.collection_link != blank %}
        <a href="{{ collections[section.settings.collection].url }}" class="product-slider__view-all">
          {{ 'sections.product_slider.view_all' | t }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="product-slider__container">
    <div class="product-slider__wrapper" data-slider-wrapper>
      
      <!-- Navigation arrows -->
      <button
        type="button"
        class="product-slider__nav product-slider__nav--prev"
        data-slider-prev
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        {% render 'icon-caret' %}
      </button>

      <button
        type="button"
        class="product-slider__nav product-slider__nav--next"
        data-slider-next
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        {% render 'icon-caret' %}
      </button>

      <!-- Slider content -->
      <div 
        class="product-slider__track"
        data-slider-track
        data-products-desktop="{{ section.settings.columns_desktop | default: 4 }}"
        data-products-tablet="{{ section.settings.columns_tablet | default: 3 }}"
        data-products-mobile="{{ section.settings.columns_mobile | default: 2 }}"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-speed="{{ slide_speed }}"
      >
        {% for product in collection.products limit: products_to_show %}
          <div class="product-slider__slide">
            <div class="product-slider__product-card">
              
              <!-- Product image -->
              <div class="product-slider__image-wrapper">
                {% if product.featured_media %}
                  <a href="{{ product.url }}" class="product-slider__image-link">
                    {{ product.featured_media | image_url: width: 600 | image_tag: 
                      class: 'product-slider__image', 
                      alt: product.featured_media.alt | escape,
                      loading: 'lazy'
                    }}
                  </a>
                {% else %}
                  <div class="product-slider__image-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'product-slider__image' }}
                  </div>
                {% endif %}

                <!-- Product info overlay -->
                <div class="product-slider__overlay">
                  <div class="product-slider__product-info">
                    <h3 class="product-slider__product-title">
                      <a href="{{ product.url }}" class="product-slider__product-link">
                        {{ product.title | escape }}
                      </a>
                    </h3>
                    
                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <p class="product-slider__vendor">{{ product.vendor | escape }}</p>
                    {% endif %}

                    {% if section.settings.show_price %}
                      <div class="product-slider__price">
                        {% render 'price', product: product, show_compare_at: section.settings.show_compare_at %}
                      </div>
                    {% endif %}

                    {% if section.settings.show_quick_add %}
                      <div class="product-slider__quick-add">
                        {% if product.available %}
                          {% if product.variants.size > 1 %}
                            <a href="{{ product.url }}" class="button button--secondary button--small">
                              {{ 'products.product.choose_options' | t }}
                            </a>
                          {% else %}
                            <button 
                              type="button" 
                              class="button button--primary button--small"
                              data-product-id="{{ product.id }}"
                              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                            >
                              {{ 'products.product.add_to_cart' | t }}
                            </button>
                          {% endif %}
                        {% else %}
                          <button type="button" class="button button--secondary button--small" disabled>
                            {{ 'products.product.sold_out' | t }}
                          </button>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Slider indicators -->
    {% if section.settings.show_dots %}
      <div class="product-slider__dots" data-slider-dots></div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.product-slider {
  padding-top: var(--section-padding-top, 50px);
  padding-bottom: var(--section-padding-bottom, 50px);
  overflow: hidden;
}

.product-slider__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rem;
}

.product-slider__heading {
  font-size: 3.6rem;
  text-transform: uppercase;
  letter-spacing: 0.2rem;
  margin: 0;
}

.product-slider__view-all {
  text-decoration: none;
  color: rgba(var(--color-base-text), 0.7);
  font-size: 1.4rem;
  transition: color var(--duration-short) ease;
}

.product-slider__view-all:hover {
  color: rgba(var(--color-base-text), 1);
}

.product-slider__container {
  position: relative;
}

.product-slider__wrapper {
  position: relative;
  overflow: hidden;
}

.product-slider__track {
  display: flex;
  transition: transform var(--duration-default) ease;
  gap: 2rem;
}

.product-slider__slide {
  flex: none;
  width: calc((100% - 6rem) / 4); /* 4 products desktop */
}

.product-slider__product-card {
  position: relative;
  height: 100%;
}

.product-slider__image-wrapper {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background-color: rgba(var(--color-base-text), 0.04);
}

.product-slider__image-link {
  display: block;
  width: 100%;
  height: 100%;
}

.product-slider__image,
.product-slider__image-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--duration-long) ease;
}

.product-slider__image-placeholder svg {
  width: 100%;
  height: 100%;
}

.product-slider__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--duration-default) ease;
}

.product-slider__product-card:hover .product-slider__overlay {
  opacity: 1;
}

.product-slider__product-card:hover .product-slider__image {
  transform: scale(1.05);
}

.product-slider__product-info {
  text-align: center;
  color: #ffffff;
  padding: 2rem;
}

.product-slider__product-title {
  font-size: 1.8rem;
  margin: 0 0 0.5rem;
  line-height: 1.3;
}

.product-slider__product-link {
  color: inherit;
  text-decoration: none;
}

.product-slider__vendor {
  font-size: 1.2rem;
  opacity: 0.8;
  margin: 0 0 1rem;
}

.product-slider__price {
  margin-bottom: 1.5rem;
}

.product-slider__quick-add {
  margin-top: 1rem;
}

/* Navigation arrows */
.product-slider__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(var(--color-base-background-1), 0.9);
  border: 1px solid rgba(var(--color-base-text), 0.2);
  border-radius: 50%;
  width: 5rem;
  height: 5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
  transition: all var(--duration-short) ease;
}

.product-slider__nav:hover {
  background: rgba(var(--color-base-background-1), 1);
  border-color: rgba(var(--color-base-text), 0.4);
  transform: translateY(-50%) scale(1.1);
}

.product-slider__nav--prev {
  left: -2.5rem;
  transform: translateY(-50%) rotate(90deg);
}

.product-slider__nav--next {
  right: -2.5rem;
  transform: translateY(-50%) rotate(-90deg);
}

.product-slider__nav--prev:hover {
  transform: translateY(-50%) rotate(90deg) scale(1.1);
}

.product-slider__nav--next:hover {
  transform: translateY(-50%) rotate(-90deg) scale(1.1);
}

.product-slider__nav .icon {
  width: 1.5rem;
  height: 1.5rem;
}

/* Dots indicator */
.product-slider__dots {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-top: 3rem;
}

.product-slider__dot {
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: rgba(var(--color-base-text), 0.2);
  cursor: pointer;
  transition: background-color var(--duration-short) ease;
}

.product-slider__dot--active {
  background: rgba(var(--color-base-text), 0.7);
}

/* Tablet styles */
@media screen and (min-width: 750px) and (max-width: 1199px) {
  .product-slider__slide {
    width: calc((100% - 4rem) / 3); /* 3 products tablet */
  }

  .product-slider__heading {
    font-size: 3rem;
  }
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .product-slider__slide {
    width: calc((100% - 2rem) / 2); /* 2 products mobile */
  }

  .product-slider__heading {
    font-size: 2.4rem;
  }

  .product-slider__header {
    margin-bottom: 2rem;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .product-slider__nav {
    width: 4rem;
    height: 4rem;
  }

  .product-slider__nav--prev {
    left: -1.5rem;
  }

  .product-slider__nav--next {
    right: -1.5rem;
  }

  .product-slider__product-info {
    padding: 1.5rem;
  }

  .product-slider__product-title {
    font-size: 1.6rem;
  }
}
{% endstylesheet %}

{% javascript %}
class ProductSlider extends HTMLElement {
  constructor() {
    super();
    this.slider = this.querySelector('[data-slider-track]');
    this.slides = this.querySelectorAll('.product-slider__slide');
    this.prevBtn = this.querySelector('[data-slider-prev]');
    this.nextBtn = this.querySelector('[data-slider-next]');
    this.dotsContainer = this.querySelector('[data-slider-dots]');
    
    this.currentIndex = 0;
    this.slidesToShow = this.getSlidesToShow();
    this.maxIndex = Math.max(0, this.slides.length - this.slidesToShow);
    this.autoplaySpeed = parseInt(this.slider.dataset.autoplaySpeed) || 5000;
    this.autoplayEnabled = this.slider.dataset.autoplay === 'true';
    this.autoplayTimer = null;
    
    this.init();
  }

  init() {
    this.createDots();
    this.updateSlider();
    this.bindEvents();
    
    if (this.autoplayEnabled) {
      this.startAutoplay();
    }
    
    // Update on resize
    window.addEventListener('resize', this.debounce(() => {
      this.slidesToShow = this.getSlidesToShow();
      this.maxIndex = Math.max(0, this.slides.length - this.slidesToShow);
      this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
      this.updateSlider();
    }, 250));
  }

  getSlidesToShow() {
    if (window.innerWidth >= 1200) {
      return parseInt(this.slider.dataset.productsDesktop) || 4;
    } else if (window.innerWidth >= 750) {
      return parseInt(this.slider.dataset.productsTablet) || 3;
    } else {
      return parseInt(this.slider.dataset.productsMobile) || 2;
    }
  }

  createDots() {
    if (!this.dotsContainer) return;
    
    const dotsCount = this.maxIndex + 1;
    this.dotsContainer.innerHTML = '';
    
    for (let i = 0; i <= this.maxIndex; i++) {
      const dot = document.createElement('button');
      dot.className = `product-slider__dot ${i === 0 ? 'product-slider__dot--active' : ''}`;
      dot.addEventListener('click', () => this.goToSlide(i));
      this.dotsContainer.appendChild(dot);
    }
  }

  bindEvents() {
    this.prevBtn?.addEventListener('click', () => this.previousSlide());
    this.nextBtn?.addEventListener('click', () => this.nextSlide());
    
    // Pause autoplay on hover
    this.addEventListener('mouseenter', () => this.stopAutoplay());
    this.addEventListener('mouseleave', () => {
      if (this.autoplayEnabled) this.startAutoplay();
    });
  }

  updateSlider() {
    const slideWidth = 100 / this.slidesToShow;
    const translateX = -this.currentIndex * slideWidth;
    
    this.slider.style.transform = `translateX(${translateX}%)`;
    this.updateNavigation();
    this.updateDots();
  }

  updateNavigation() {
    if (this.prevBtn) {
      this.prevBtn.disabled = this.currentIndex === 0;
      this.prevBtn.style.opacity = this.currentIndex === 0 ? '0.5' : '1';
    }
    
    if (this.nextBtn) {
      this.nextBtn.disabled = this.currentIndex >= this.maxIndex;
      this.nextBtn.style.opacity = this.currentIndex >= this.maxIndex ? '0.5' : '1';
    }
  }

  updateDots() {
    if (!this.dotsContainer) return;
    
    const dots = this.dotsContainer.querySelectorAll('.product-slider__dot');
    dots.forEach((dot, index) => {
      dot.classList.toggle('product-slider__dot--active', index === this.currentIndex);
    });
  }

  previousSlide() {
    if (this.currentIndex > 0) {
      this.currentIndex--;
      this.updateSlider();
    }
  }

  nextSlide() {
    if (this.currentIndex < this.maxIndex) {
      this.currentIndex++;
      this.updateSlider();
    }
  }

  goToSlide(index) {
    this.currentIndex = Math.max(0, Math.min(index, this.maxIndex));
    this.updateSlider();
  }

  startAutoplay() {
    this.stopAutoplay();
    this.autoplayTimer = setInterval(() => {
      if (this.currentIndex >= this.maxIndex) {
        this.currentIndex = 0;
      } else {
        this.currentIndex++;
      }
      this.updateSlider();
    }, this.autoplaySpeed);
  }

  stopAutoplay() {
    if (this.autoplayTimer) {
      clearInterval(this.autoplayTimer);
      this.autoplayTimer = null;
    }
  }

  debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }
}

customElements.define('product-slider', ProductSlider);
{% endjavascript %}

{% schema %}
{
  "name": "Product Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "collection_link",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "header",
      "content": "Product display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": " products",
      "label": "Maximum products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_at",
      "label": "Show compare at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": false
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": " columns",
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "unit": " columns",
      "label": "Tablet columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": " columns",
      "label": "Mobile columns",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "slide_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide indicators",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Product Slider"
    }
  ]
}
{% endschema %} 