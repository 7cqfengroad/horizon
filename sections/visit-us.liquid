{{ 'visit-us.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign address = section.settings.address
  assign button_text = section.settings.button_text
  assign button_link = section.settings.button_link
  assign image = section.settings.image
  assign background_color = section.settings.background_color
-%}

<section class="visit-us section-padding" 
         style="--bg-color: {{ background_color | default: '#e8ddd4' }};">
  <div class="container">
    <div class="visit-us__inner">
      
      <!-- Content Side -->
      <div class="visit-us__content">
        
        {%- if heading != blank -%}
          <h2 class="visit-us__heading h2">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if description != blank -%}
          <div class="visit-us__description">
            <p>{{ description | escape }}</p>
          </div>
        {%- endif -%}

        {%- if address != blank -%}
          <div class="visit-us__address">
            {{ address }}
          </div>
        {%- endif -%}

        {%- if button_text != blank and button_link != blank -%}
          <div class="visit-us__actions">
            <a href="{{ button_link }}" class="visit-us__button btn btn--primary">
              {{ button_text | escape }}
            </a>
          </div>
        {%- endif -%}

      </div>

      <!-- Image Side -->
      <div class="visit-us__media">
        {%- if image -%}
          <img 
            src="{{ image | image_url: width: 600 }}"
            alt="{{ image.alt | escape }}"
            width="600"
            height="400"
            class="visit-us__image"
            loading="lazy"
          >
        {%- else -%}
          <div class="visit-us__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visit Us",
  "tag": "section", 
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Visit us in New York"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>745 Madison | 63rd Floor<br>New York, NY 10020</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "DIRECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e8ddd4"
    }
  ],
  "presets": [
    {
      "name": "Visit Us"
    }
  ]
}
{% endschema %} 