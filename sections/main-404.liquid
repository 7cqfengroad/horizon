{% comment %}
  Main 404 Section
  Basic 404 error page
{% endcomment %}

<section class="section-404" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="error-404">
      <h1>{{ 'general.404.title' | t }}</h1>
      <p>{{ 'general.404.subtext' | t }}</p>
      
      <div class="error-404__search">
        <p>Maybe you want to try the search instead?</p>
        
        <form action="{{ routes.search_url }}" method="get" role="search">
          <div class="search-wrapper">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search..."
              aria-label="Search"
            >
            <button type="submit">Search</button>
          </div>
        </form>
      </div>
      
      <div class="error-404__links">
        <p>
          Back to
          <a href="{{ routes.root_url }}">{{ shop.name }}</a>
          |
          <a href="javascript:history.back()">previous page</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .section-404 {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }
  
  .error-404 {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .error-404 h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--color-base-text);
  }
  
  .error-404 p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    color: var(--color-accent-gray);
  }
  
  .search-wrapper {
    display: flex;
    max-width: 400px;
    margin: 0 auto 2rem;
    border: 1px solid var(--color-accent-gray);
  }
  
  .search-wrapper input {
    flex: 1;
    padding: 12px 16px;
    border: none;
    font-size: 1rem;
  }
  
  .search-wrapper button {
    padding: 12px 20px;
    background: var(--color-base-text);
    color: white;
    border: none;
    cursor: pointer;
  }
  
  .error-404__links a {
    color: var(--color-accent-gold);
    text-decoration: none;
  }
  
  .error-404__links a:hover {
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %} 