{%- liquid
  assign bg_color = section.settings.background_color | default: '#f7f7f7'
  assign padding_top = section.settings.section_padding_top | default: 60
  assign padding_bottom = section.settings.section_padding_bottom | default: 60
-%}

<section 
  class="zodiac-section section"
  style="background-color: {{ bg_color }}; padding: {{ padding_top }}px 20px {{ padding_bottom }}px;"
>
  <div class="page-width">
    <div class="zodiac-container">
      
      <!-- 左侧图片 -->
      <div class="zodiac-image-left">
        {%- if section.settings.image_left != blank -%}
          {{- section.settings.image_left | image_url: width: 600 | image_tag: 
              loading: 'lazy',
              alt: section.settings.image_left_alt,
              class: 'zodiac-img'
          -}}
        {%- else -%}
          <div class="zodiac-placeholder">
            <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
              <rect width="300" height="400" fill="#e5e5e5"/>
              <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">星座吊坠图片</text>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <!-- 中间文字内容 -->
      <div class="zodiac-content">
        {%- if section.settings.title != blank -%}
          <h2 class="zodiac-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <h3 class="zodiac-subtitle">{{ section.settings.subtitle }}</h3>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <div class="zodiac-description">{{ section.settings.description }}</div>
        {%- endif -%}
        
        {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="zodiac-btn btn btn--secondary">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>

      <!-- 右侧图片 -->
      <div class="zodiac-image-right">
        {%- if section.settings.image_right != blank -%}
          {{- section.settings.image_right | image_url: width: 600 | image_tag: 
              loading: 'lazy',
              alt: section.settings.image_right_alt,
              class: 'zodiac-img'
          -}}
        {%- else -%}
          <div class="zodiac-placeholder">
            <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
              <rect width="300" height="400" fill="#e5e5e5"/>
              <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">星座吊坠图片</text>
            </svg>
          </div>
        {%- endif -%}
      </div>
      
    </div>
  </div>
</section>

{% stylesheet %}
.zodiac-section {
  background-color: #f7f7f7;
}

.zodiac-container {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.zodiac-image-left,
.zodiac-image-right {
  text-align: center;
}

.zodiac-img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  transition: transform 0.3s ease;
}

.zodiac-img:hover {
  transform: scale(1.02);
}

.zodiac-placeholder {
  display: inline-block;
  border-radius: 8px;
  overflow: hidden;
}

.zodiac-content {
  text-align: center;
  padding: 0 20px;
}

.zodiac-title {
  font-size: 2.5rem;
  font-weight: 300;
  margin: 0 0 0.5rem 0;
  color: #333;
  letter-spacing: 0.02em;
}

.zodiac-subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 1.5rem 0;
  color: #666;
  font-style: italic;
}

.zodiac-description {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem 0;
  color: #555;
}

.zodiac-btn {
  margin-top: 1rem;
}

/* 移动端响应式 */
@media screen and (max-width: 768px) {
  .zodiac-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .zodiac-title {
    font-size: 2rem;
  }
  
  .zodiac-subtitle {
    font-size: 1.1rem;
  }
}

@media screen and (max-width: 480px) {
  .zodiac-title {
    font-size: 1.8rem;
  }
}

/* 无障碍支持 */
@media (prefers-reduced-motion: reduce) {
  .zodiac-img {
    transition: none;
  }
  
  .zodiac-img:hover {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "星座系列",
  "settings": [
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "左侧图片"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "左侧图片描述",
      "default": "Zodiac Pendant Capricorn"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "右侧图片"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "右侧图片描述", 
      "default": "Zodiac Pendant Pisces"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Zodiac"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "Pendant Necklaces"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接",
      "default": "/collections/zodiac"
    },
    {
      "type": "header",
      "content": "样式设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "星座系列"
    }
  ]
}
{% endschema %} 