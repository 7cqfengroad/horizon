{% liquid
  assign section_id = 'hero-video-' | append: section.id
  assign desktop_video = section.settings.desktop_video
  assign mobile_video = section.settings.mobile_video
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign link_url = section.settings.link_url
  assign text_color = section.settings.text_color
%}

<section id="{{ section_id }}" class="hero-video">
  <div class="hero-video__wrapper">
    {%- if desktop_video or mobile_video -%}
      <div class="hero-video__media">
        {%- if desktop_video -%}
          <video
            class="hero-video__video hero-video__video--desktop"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          >
            <source src="{{ desktop_video }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {%- endif -%}

        {%- if mobile_video -%}
          <video
            class="hero-video__video hero-video__video--mobile"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          >
            <source src="{{ mobile_video }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hero-video__content">
      <div class="hero-video__text">
        {%- if title -%}
          <h1 class="hero-video__title">{{ title | escape }}</h1>
        {%- endif -%}
        
        {%- if subtitle -%}
          <p class="hero-video__subtitle">{{ subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if link_url -%}
      <a href="{{ link_url }}" class="hero-video__link" aria-label="{{ title | escape }}">
        <span class="visually-hidden">{{ title | escape }}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% style %}
  #{{ section_id }} {
    --text-color: {{ text_color | default: '#f7f7f7' }};
  }

  .hero-video {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video__wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-video__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-video__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-video__video--desktop {
    display: block;
  }

  .hero-video__video--mobile {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .hero-video__video--desktop {
      display: none;
    }

    .hero-video__video--mobile {
      display: block;
    }
  }

  .hero-video__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    text-align: center;
    color: var(--text-color);
  }

  .hero-video__text {
    max-width: 800px;
    padding: 0 2rem;
  }

  .hero-video__title {
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
    line-height: 1.1;
  }

  .hero-video__subtitle {
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.1em;
    margin: 0;
    opacity: 0.9;
  }

  .hero-video__link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .hero-video__link:hover + .hero-video__content .hero-video__title {
    transform: scale(1.02);
    transition: transform 0.3s ease;
  }

  /* Accessibility: Respect motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .hero-video__video {
      animation-play-state: paused;
    }

    .hero-video__link:hover + .hero-video__content .hero-video__title {
      transform: none;
    }
  }

  /* Fallback background for video loading */
  .hero-video__media::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-base-background-3);
    z-index: -1;
  }
{% endstyle %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const videos = document.querySelectorAll('.hero-video__video');
  
  videos.forEach(video => {
    // Ensure videos play on mobile devices
    video.addEventListener('loadedmetadata', function() {
      this.play().catch(e => {
        console.log('Video autoplay failed:', e);
      });
    });

    // Handle video errors
    video.addEventListener('error', function() {
      console.log('Video failed to load');
      this.style.display = 'none';
    });
  });

  // Pause videos when user prefers reduced motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    videos.forEach(video => {
      video.pause();
    });
  }
});
</script>

{% schema %}
{
  "name": "Hero Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "url",
      "id": "desktop_video",
      "label": "Desktop Video URL",
      "info": "Upload video to Files section and paste URL here"
    },
    {
      "type": "url",
      "id": "mobile_video", 
      "label": "Mobile Video URL",
      "info": "Upload video to Files section and paste URL here"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Heritage of Style"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Make the entire video clickable"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7f7f7"
    }
  ],
  "presets": [
    {
      "name": "Hero Video",
      "settings": {
        "title": "Heritage of Style",
        "subtitle": "Explore the Collection",
        "text_color": "#f7f7f7"
      }
    }
  ]
}
{% endschema %} 