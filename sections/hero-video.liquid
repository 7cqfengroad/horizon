{% comment %}
  Hero Video Section
  全屏视频背景，支持桌面和移动端不同视频，带文字覆盖
{% endcomment %}

<section id="HeroVideo-{{ section.id }}" class="hero-video hero-video--{{ section.settings.height }}">
  <div class="hero-video__wrapper">
    {%- if section.settings.desktop_video != blank or section.settings.mobile_video != blank -%}
      <!-- 桌面端视频 -->
      {%- if section.settings.desktop_video != blank -%}
        <video
          class="hero-video__media hero-video__media--desktop"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          {%- if section.settings.desktop_poster != blank -%}
            poster="{{ section.settings.desktop_poster | image_url: width: 1920 }}"
          {%- endif -%}
          aria-hidden="true"
        >
          <source src="{{ section.settings.desktop_video }}" type="video/mp4">
          {%- comment -%} 备用图片，当视频无法播放时显示 {%- endcomment -%}
          {%- if section.settings.desktop_poster != blank -%}
            <img 
              src="{{ section.settings.desktop_poster | image_url: width: 1920 }}"
              alt="{{ section.settings.title | escape }}"
              loading="lazy"
            >
          {%- endif -%}
        </video>
      {%- endif -%}

      <!-- 移动端视频 -->
      {%- if section.settings.mobile_video != blank -%}
        <video
          class="hero-video__media hero-video__media--mobile"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          {%- if section.settings.mobile_poster != blank -%}
            poster="{{ section.settings.mobile_poster | image_url: width: 800 }}"
          {%- endif -%}
          aria-hidden="true"
        >
          <source src="{{ section.settings.mobile_video }}" type="video/mp4">
          {%- comment -%} 备用图片，当视频无法播放时显示 {%- endcomment -%}
          {%- if section.settings.mobile_poster != blank -%}
            <img 
              src="{{ section.settings.mobile_poster | image_url: width: 800 }}"
              alt="{{ section.settings.title | escape }}"
              loading="lazy"
            >
          {%- endif -%}
        </video>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} 如果没有视频，显示占位背景图片 {%- endcomment -%}
      {%- if section.settings.fallback_image != blank -%}
        <div class="hero-video__fallback">
          {{ section.settings.fallback_image | image_url: width: 1920 | image_tag: 
            loading: 'lazy',
            alt: section.settings.title
          }}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} 文字覆盖内容 {%- endcomment -%}
    <div class="hero-video__content">
      <div class="hero-video__content-wrapper">
        {%- if section.settings.title != blank -%}
          <h1 class="hero-video__title">
            {{ section.settings.title | escape }}
          </h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="hero-video__subtitle">
            {{ section.settings.subtitle | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
          <a 
            href="{{ section.settings.button_url }}" 
            class="hero-video__button btn btn--primary"
          >
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} 整个区域可点击链接覆盖 {%- endcomment -%}
    {%- if section.settings.link_url != blank and section.settings.enable_full_click -%}
      <a 
        href="{{ section.settings.link_url }}" 
        class="hero-video__link-overlay"
        aria-label="{{ 'sections.hero_video.explore_collection' | t }}"
        tabindex="-1"
      ></a>
    {%- endif -%}
  </div>
</section>

<style>
.hero-video {
  position: relative;
  width: 100%;
  overflow: hidden;
  background-color: #000;
}

.hero-video--small {
  height: 50vh;
  min-height: 400px;
}

.hero-video--medium {
  height: 70vh;
  min-height: 500px;
}

.hero-video--large {
  height: 100vh;
  min-height: 600px;
}

.hero-video__wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-video__media {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
  z-index: 1;
}

.hero-video__media--mobile {
  display: none;
}

.hero-video__fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-video__fallback img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-video__content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  background: rgba(0, 0, 0, 0.2); /* 轻微暗化背景 */
}

.hero-video__content-wrapper {
  text-align: center;
  color: {{ section.settings.text_color | default: '#f7f7f7' }};
  max-width: 600px;
  padding: 20px;
}

.hero-video__title {
  font-size: 3.5rem;
  font-weight: 300;
  letter-spacing: 0.05em;
  margin: 0 0 1rem 0;
  line-height: 1.2;
}

.hero-video__subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 2rem 0;
  opacity: 0.9;
}

.hero-video__button {
  display: inline-block;
  padding: 12px 30px;
  font-size: 1rem;
  text-decoration: none;
  border: 2px solid currentColor;
  background: transparent;
  color: inherit;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.hero-video__button:hover,
.hero-video__button:focus {
  background: currentColor;
  color: #000;
  transform: translateY(-2px);
}

.hero-video__link-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: transparent;
  cursor: pointer;
}

/* 移动端适配 */
@media screen and (max-width: 768px) {
  .hero-video__media--desktop {
    display: none;
  }
  
  .hero-video__media--mobile {
    display: block;
  }
  
  .hero-video--large {
    height: 70vh;
    min-height: 500px;
  }
  
  .hero-video__title {
    font-size: 2.5rem;
  }
  
  .hero-video__subtitle {
    font-size: 1rem;
  }
  
  .hero-video__content-wrapper {
    padding: 15px;
  }
}

@media screen and (max-width: 480px) {
  .hero-video__title {
    font-size: 2rem;
  }
  
  .hero-video__button {
    font-size: 0.9rem;
    padding: 10px 25px;
  }
}

/* 提高对比度模式 */
@media (prefers-contrast: more) {
  .hero-video__content {
    background: rgba(0, 0, 0, 0.6);
  }
  
  .hero-video__button {
    border-width: 3px;
  }
}

/* 减少动画模式 */
@media (prefers-reduced-motion: reduce) {
  .hero-video__button {
    transition: none;
  }
  
  .hero-video__button:hover,
  .hero-video__button:focus {
    transform: none;
  }
}
</style>

{% schema %}
{
  "name": "英雄视频区",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "视频设置"
    },
    {
      "type": "url",
      "id": "desktop_video",
      "label": "桌面端视频URL",
      "info": "建议使用MP4格式，文件大小不超过10MB"
    },
    {
      "type": "image_picker",
      "id": "desktop_poster",
      "label": "桌面端视频封面图"
    },
    {
      "type": "url",
      "id": "mobile_video",
      "label": "移动端视频URL",
      "info": "建议使用MP4格式，文件大小不超过5MB"
    },
    {
      "type": "image_picker",
      "id": "mobile_poster",
      "label": "移动端视频封面图"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "备用背景图片",
      "info": "当视频无法播放时显示"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Heritage of Style"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "Explore the Collection"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#f7f7f7"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接"
    },
    {
      "type": "header",
      "content": "链接设置"
    },
    {
      "type": "checkbox",
      "id": "enable_full_click",
      "label": "启用整个区域可点击",
      "default": true,
      "info": "启用后整个视频区域都可以点击跳转"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "区域点击链接",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "select",
      "id": "height",
      "label": "区域高度",
      "options": [
        {
          "value": "small",
          "label": "小 (50vh)"
        },
        {
          "value": "medium",
          "label": "中 (70vh)"
        },
        {
          "value": "large",
          "label": "大 (100vh)"
        }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "英雄视频区"
    }
  ]
}
{% endschema %} 