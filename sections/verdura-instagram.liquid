 → {% comment %}
  Verdura Instagram Section
  复刻 Instagram 展示区域 - "Find us on Instagram"
{% endcomment %}

<section class="instagram-section" id="instagram">
  <div class="page-width">
    <div class="instagram-section__wrapper">
      
      <!-- Section Header -->
      <div class="instagram-section__header">
        <h2 class="instagram-section__title h2">
          {% if section.settings.instagram_title != blank %}
            {{ section.settings.instagram_title }}
          {% else %}
            Find us on Instagram
          {% endif %}
        </h2>
        
        {% if section.settings.instagram_handle != blank %}
          <a href="https://www.instagram.com/{{ section.settings.instagram_handle }}/" 
             class="instagram-section__handle"
             target="_blank"
             rel="noopener">
            @{{ section.settings.instagram_handle }}
          </a>
        {% endif %}
      </div>

      <!-- Instagram Feed Grid -->
      <div class="instagram-section__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'instagram_post' %}
              <div class="instagram-post" {{ block.shopify_attributes }}>
                {% if block.settings.post_image != blank %}
                  <div class="instagram-post__image">
                    {% if block.settings.post_link != blank %}
                      <a href="{{ block.settings.post_link }}" 
                         target="_blank" 
                         rel="noopener"
                         class="instagram-post__link">
                    {% endif %}
                        <img src="{{ block.settings.post_image | image_url: width: 400 }}" 
                             alt="Instagram post"
                             loading="lazy">
                        <div class="instagram-post__overlay">
                          <svg class="instagram-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>
                          </svg>
                        </div>
                    {% if block.settings.post_link != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
        
        <!-- Fallback content when no blocks are added -->
        {% if section.blocks.size == 0 %}
          <div class="instagram-post">
            <div class="instagram-post__image">
              <a href="https://www.instagram.com/p/DNDjfrKtO-m/" target="_blank" rel="noopener" class="instagram-post__link">
                <img src="https://ext.same-assets.com/3425221127/1509665876.jpeg" 
                     alt="Instagram post"
                     loading="lazy">
                <div class="instagram-post__overlay">
                  <svg class="instagram-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              </a>
            </div>
          </div>
          
          <div class="instagram-post">
            <div class="instagram-post__image">
              <a href="https://www.instagram.com/p/DM-kW1StNh6/" target="_blank" rel="noopener" class="instagram-post__link">
                <img src="https://ext.same-assets.com/3425221127/284352408.jpeg" 
                     alt="Instagram post"
                     loading="lazy">
                <div class="instagram-post__overlay">
                  <svg class="instagram-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              </a>
            </div>
          </div>
          
          <div class="instagram-post">
            <div class="instagram-post__image">
              <a href="https://www.instagram.com/p/DMxh8u5MMOk/" target="_blank" rel="noopener" class="instagram-post__link">
                <img src="https://ext.same-assets.com/3425221127/3506822966.jpeg" 
                     alt="Instagram post"
                     loading="lazy">
                <div class="instagram-post__overlay">
                  <svg class="instagram-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              </a>
            </div>
          </div>
          
          <div class="instagram-post">
            <div class="instagram-post__image">
              <a href="https://www.instagram.com/reel/DMsi1BlMEUc/" target="_blank" rel="noopener" class="instagram-post__link">
                <img src="https://ext.same-assets.com/3425221127/1449727131.jpeg" 
                     alt="Instagram post"
                     loading="lazy">
                <div class="instagram-post__overlay">
                  <svg class="instagram-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              </a>
            </div>
          </div>
        {% endif %}
      </div>
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "text",
      "id": "instagram_title",
      "label": "Section Title",
      "default": "Find us on Instagram"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "verdurajewelry",
      "info": "Enter without @"
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "post_image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "post_link",
          "label": "Instagram Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        },
        {
          "type": "instagram_post"
        }
      ]
    }
  ]
}
{% endschema %}