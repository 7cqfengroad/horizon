{%- comment -%}
  Header Section - Verdura Style
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign show_header_shadow = section.settings.show_header_shadow
-%}

<style>
  .header-wrapper {
    background: {{ section.settings.color_scheme.settings.background }};
    border-bottom: 1px solid rgba(var(--color-base-text), 0.08);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .header__logo {
    flex: 0 0 auto;
    text-decoration: none;
    color: rgb(var(--color-base-text));
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 2.4rem;
    letter-spacing: 0.1rem;
  }

  .header__navigation {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 3rem;
  }

  .header__menu-item {
    position: relative;
  }

  .header__menu-link {
    text-decoration: none;
    color: rgb(var(--color-base-text));
    font-size: 1.4rem;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    padding: 1rem 0;
    transition: color 0.3s ease;
    border-bottom: 2px solid transparent;
  }

  .header__menu-link:hover {
    color: rgb(var(--color-base-accent-1));
    border-bottom-color: rgb(var(--color-base-accent-1));
  }

  .header__submenu {
    position: absolute;
    top: 100%;
    left: 0;
    background: rgb(var(--color-base-background-1));
    border: 1px solid rgba(var(--color-base-text), 0.08);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 100;
    list-style: none;
    margin: 0;
    padding: 1rem 0;
  }

  .header__menu-item:hover .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__submenu-link {
    display: block;
    text-decoration: none;
    color: rgb(var(--color-base-text));
    padding: 0.8rem 2rem;
    font-size: 1.3rem;
    letter-spacing: 0.02rem;
    transition: background-color 0.3s ease;
  }

  .header__submenu-link:hover {
    background-color: rgba(var(--color-base-text), 0.05);
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__icon {
    text-decoration: none;
    color: rgb(var(--color-base-text));
    font-size: 1.6rem;
    transition: color 0.3s ease;
  }

  .header__icon:hover {
    color: rgb(var(--color-base-accent-1));
  }

  .header__cart-count {
    background: rgb(var(--color-base-accent-1));
    color: rgb(var(--color-base-background-1));
    border-radius: 50%;
    min-width: 1.8rem;
    height: 1.8rem;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.5rem;
  }

  /* Mobile Navigation */
  .header__mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 2rem;
    color: rgb(var(--color-base-text));
    cursor: pointer;
  }

  .header__mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgb(var(--color-base-background-1));
    z-index: 1000;
    padding: 2rem;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .header__mobile-menu.active {
    transform: translateX(0);
  }

  .header__mobile-menu-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: none;
    border: none;
    font-size: 2rem;
    color: rgb(var(--color-base-text));
    cursor: pointer;
  }

  .header__mobile-menu-list {
    list-style: none;
    margin: 4rem 0 0 0;
    padding: 0;
  }

  .header__mobile-menu-item {
    margin-bottom: 2rem;
  }

  .header__mobile-menu-link {
    text-decoration: none;
    color: rgb(var(--color-base-text));
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  @media screen and (max-width: 990px) {
    .header__navigation {
      display: none;
    }

    .header__mobile-menu-toggle {
      display: block;
    }

    .header__mobile-menu {
      display: block;
    }
  }
</style>

<div class="header-wrapper">
  <header class="header">
    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="header__logo">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" 
             alt="{{ shop.name }}" 
             width="{{ section.settings.logo_width }}"
             height="auto">
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__navigation">
      <ul class="header__menu">
        <li class="header__menu-item">
          <a href="/collections" class="header__menu-link">The Collection</a>
        </li>
        <li class="header__menu-item">
          <a href="#" class="header__menu-link">Shop by Category</a>
          <ul class="header__submenu">
            <li><a href="/collections/bracelets-watches" class="header__submenu-link">Bracelets & Watches</a></li>
            <li><a href="/collections/cuffs" class="header__submenu-link">Cuffs</a></li>
            <li><a href="/collections/earclips" class="header__submenu-link">Earclips</a></li>
            <li><a href="/collections/rings" class="header__submenu-link">Rings</a></li>
            <li><a href="/collections/necklaces" class="header__submenu-link">Necklaces</a></li>
            <li><a href="/collections/brooches" class="header__submenu-link">Brooches</a></li>
            <li><a href="/collections/mens" class="header__submenu-link">Men's</a></li>
            <li><a href="/collections/zodiac-pendant-necklaces" class="header__submenu-link">Zodiac Pendant Necklaces</a></li>
            <li><a href="/collections/all" class="header__submenu-link">All</a></li>
          </ul>
        </li>
        <li class="header__menu-item">
          <a href="#" class="header__menu-link">Shop by Collection</a>
          <ul class="header__submenu">
            <li><a href="/collections/featured-in-feud" class="header__submenu-link">Featured in Feud</a></li>
            <li><a href="/collections/off-season-collection" class="header__submenu-link">Off-Season Collection</a></li>
            <li><a href="/collections/byzantine-collection" class="header__submenu-link">Byzantine Collection</a></li>
            <li><a href="/collections/caged-collection" class="header__submenu-link">Caged Collection</a></li>
            <li><a href="/collections/constellation-collection" class="header__submenu-link">Constellation Collection</a></li>
            <li><a href="/collections/curb-link-collection" class="header__submenu-link">Curb-Link Collection</a></li>
            <li><a href="/collections/night-day-collection" class="header__submenu-link">Night & Day Collection</a></li>
            <li><a href="/collections/stardust-collection" class="header__submenu-link">Stardust Collection</a></li>
            <li><a href="/collections/vintage-verdura" class="header__submenu-link">Vintage Verdura</a></li>
            <li><a href="/collections/very-verdura-gifts-under-20000" class="header__submenu-link">Very Verdura Gifts Under $20,000</a></li>
          </ul>
        </li>
        <li class="header__menu-item">
          <a href="/pages/the-story" class="header__menu-link">The Story</a>
        </li>
        <li class="header__menu-item">
          <a href="/pages/visit" class="header__menu-link">Visit</a>
        </li>
        <li class="header__menu-item">
          <a href="/pages/contact" class="header__menu-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Header Icons -->
    <div class="header__icons">
      <!-- Search -->
      <a href="/search" class="header__icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
        </svg>
      </a>

      <!-- Account -->
      <a href="{{ routes.account_url }}" class="header__icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
        </svg>
      </a>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="header__icon" id="cart-icon-bubble">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zM4 7h12v9H4V7z" clip-rule="evenodd" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="header__mobile-menu-toggle" id="mobile-menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div class="header__mobile-menu" id="mobile-menu">
      <button class="header__mobile-menu-close" id="mobile-menu-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
      
      <ul class="header__mobile-menu-list">
        <li class="header__mobile-menu-item">
          <a href="/collections" class="header__mobile-menu-link">The Collection</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/collections/bracelets-watches" class="header__mobile-menu-link">Bracelets & Watches</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/collections/cuffs" class="header__mobile-menu-link">Cuffs</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/collections/earclips" class="header__mobile-menu-link">Earclips</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/collections/rings" class="header__mobile-menu-link">Rings</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/collections/necklaces" class="header__mobile-menu-link">Necklaces</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/pages/the-story" class="header__mobile-menu-link">The Story</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/pages/visit" class="header__mobile-menu-link">Visit</a>
        </li>
        <li class="header__mobile-menu-item">
          <a href="/pages/contact" class="header__mobile-menu-link">Contact</a>
        </li>
      </ul>
    </div>
  </header>
</div>

<script>
  // Mobile menu functionality
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');

    if (mobileMenuToggle) {
      mobileMenuToggle.addEventListener('click', function() {
        mobileMenu.classList.add('active');
      });
    }

    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', function() {
        mobileMenu.classList.remove('active');
      });
    }

    // Close mobile menu when clicking outside
    mobileMenu.addEventListener('click', function(e) {
      if (e.target === mobileMenu) {
        mobileMenu.classList.remove('active');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_header_shadow",
      "default": true,
      "label": "Show header shadow"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ]
}
{% endschema %} 