{%- liquid
  assign sticky_header = settings.enable_sticky_header
-%}

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="header{% if sticky_header %} header--sticky{% endif %}" role="banner">
  <div class="container">
    <div class="header__inner">
      
      <!-- Mobile Menu Toggle -->
      <button 
        type="button" 
        class="header__menu-toggle no-js-hidden" 
        aria-controls="navigation" 
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span class="header__menu-toggle-line"></span>
        <span class="header__menu-toggle-line"></span>
        <span class="header__menu-toggle-line"></span>
      </button>

      <!-- Logo -->
      <div class="header__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if settings.logo != blank -%}
            <img 
              src="{{ settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name | escape }}"
              width="auto"
              height="40"
              class="header__logo-image"
            >
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="header__nav desktop-only" id="navigation" role="navigation">
        <ul class="header__nav-list" role="list">
          {%- for link in linklists.main-menu.links -%}
            <li class="header__nav-item">
              <a 
                href="{{ link.url }}" 
                class="header__nav-link{% if link.active %} header__nav-link--active{% endif %}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
              
              {%- if link.links != blank -%}
                <ul class="header__submenu" role="list">
                  {%- for childlink in link.links -%}
                    <li class="header__submenu-item">
                      <a 
                        href="{{ childlink.url }}" 
                        class="header__submenu-link{% if childlink.active %} header__submenu-link--active{% endif %}"
                        {% if childlink.current %}aria-current="page"{% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="header__actions">
        
        <!-- Search -->
        {%- if settings.enable_search -%}
          <button 
            type="button" 
            class="header__action header__search-toggle"
            aria-label="Open search"
            aria-controls="search-modal"
            aria-expanded="false"
          >
            <svg class="icon icon-search" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M19 19L13 13M15 8A7 7 0 1 1 1 8A7 7 0 0 1 15 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        <!-- Account -->
        <a href="{{ routes.account_url }}" class="header__action header__account">
          <svg class="icon icon-account" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M16 17V15C16 13.8954 15.1046 13 14 13H6C4.89543 13 4 13.8954 4 15V17M12 5C12 7.20914 10.2091 9 8 9C5.79086 9 4 7.20914 4 5C4 2.79086 5.79086 1 8 1C10.2091 1 12 2.79086 12 5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="visually-hidden">Account</span>
        </a>

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="header__action header__cart" id="cart-icon-bubble">
          <svg class="icon icon-cart" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 1H5L7 13H17L19 5H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8" cy="17" r="1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="15" cy="17" r="1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="header__cart-count{% if cart == empty %} visually-hidden{% endif %}" aria-hidden="true">
            {{ cart.item_count }}
          </span>
          <span class="visually-hidden">
            {{ 'sections.header.cart_count' | t: count: cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="header__mobile-nav mobile-only" id="mobile-navigation">
    <nav class="mobile-nav" role="navigation">
      <ul class="mobile-nav__list" role="list">
        {%- for link in linklists.main-menu.links -%}
          <li class="mobile-nav__item">
            <a 
              href="{{ link.url }}" 
              class="mobile-nav__link{% if link.active %} mobile-nav__link--active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
            
            {%- if link.links != blank -%}
              <button 
                type="button" 
                class="mobile-nav__toggle"
                aria-expanded="false"
                aria-label="Expand {{ link.title | escape }} menu"
              >
                <svg class="icon icon-chevron" width="16" height="16" viewBox="0 0 16 16">
                  <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              
              <ul class="mobile-nav__submenu" role="list">
                {%- for childlink in link.links -%}
                  <li class="mobile-nav__submenu-item">
                    <a 
                      href="{{ childlink.url }}" 
                      class="mobile-nav__submenu-link{% if childlink.active %} mobile-nav__submenu-link--active{% endif %}"
                      {% if childlink.current %}aria-current="page"{% endif %}
                    >
                      {{ childlink.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</header>

{%- if settings.enable_search -%}
  {% render 'search-modal' %}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_pinterest_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %} 