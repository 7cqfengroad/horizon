<header class="header" id="header">
  <div class="header__wrapper">
    <!-- Mobile Menu Toggle -->
    <button class="header__menu-toggle mobile-only" aria-label="Menu">
      <span class="menu-text">MENU</span>
    </button>

    <!-- Logo -->
    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" 
               alt="{{ shop.name }}" 
               width="200" 
               height="auto"
               class="logo__image">
        {% else %}
          <div class="logo__text">
            <span class="logo__name">VERDURA</span>
            <span class="logo__tagline">EST 1939</span>
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header__nav desktop-only" aria-label="Main navigation">
      <ul class="nav__list">
        <li class="nav__item nav__item--dropdown">
          <a href="#" class="nav__link">The Collection</a>
          <div class="nav__dropdown">
            <div class="dropdown__content">
              <div class="dropdown__column">
                <h4 class="dropdown__title">Shop by Category</h4>
                <ul class="dropdown__list">
                  <li><a href="{{ collections['bracelets-watches'].url }}">Bracelets & Watches</a></li>
                  <li><a href="{{ collections['cuffs'].url }}">Cuffs</a></li>
                  <li><a href="{{ collections['earclips'].url }}">Earclips</a></li>
                  <li><a href="{{ collections['rings'].url }}">Rings</a></li>
                  <li><a href="{{ collections['necklaces'].url }}">Necklaces</a></li>
                  <li><a href="{{ collections['brooches'].url }}">Brooches</a></li>
                  <li><a href="{{ collections['mens'].url }}">Men's</a></li>
                  <li><a href="{{ collections['zodiac-pendant-necklaces'].url }}">Zodiac Pendant Necklaces</a></li>
                  <li><a href="{{ collections.all.url }}">All</a></li>
                </ul>
              </div>
              <div class="dropdown__column">
                <h4 class="dropdown__title">Shop by Collection</h4>
                <ul class="dropdown__list">
                  <li><a href="{{ collections['featured-in-feud'].url }}">Featured in Feud</a></li>
                  <li><a href="{{ collections['off-season-collection'].url }}">Off-Season Collection</a></li>
                  <li><a href="{{ collections['byzantine-collection'].url }}">Byzantine Collection</a></li>
                  <li><a href="{{ collections['caged-collection'].url }}">Caged Collection</a></li>
                  <li><a href="{{ collections['constellation-collection'].url }}">Constellation Collection</a></li>
                  <li><a href="{{ collections['curb-link-collection'].url }}">Curb-Link Collection</a></li>
                  <li><a href="{{ collections['night-day-collection'].url }}">Night & Day Collection</a></li>
                  <li><a href="{{ collections['stardust-collection'].url }}">Stardust Collection</a></li>
                  <li><a href="{{ collections['vintage-verdura'].url }}">Vintage Verdura</a></li>
                  <li><a href="{{ collections['very-verdura-gifts-under-15-000'].url }}">Very Verdura Gifts Under $20,000</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>
        <li class="nav__item">
          <a href="{{ pages['the-story'].url }}" class="nav__link">The Story</a>
        </li>
        <li class="nav__item">
          <a href="{{ pages['visit'].url }}" class="nav__link">Visit</a>
        </li>
        <li class="nav__item">
          <a href="{{ pages['contact'].url }}" class="nav__link">Contact</a>
        </li>
        <li class="nav__item">
          <a href="{{ pages['customer-service'].url }}" class="nav__link">At Your Service</a>
        </li>
        <li class="nav__item">
          <a href="{{ blog.news.url }}" class="nav__link">News</a>
        </li>
        <li class="nav__item">
          <a href="{{ pages['catalogues'].url }}" class="nav__link">Catalogues</a>
        </li>
      </ul>
    </nav>

    <!-- Cart -->
    <div class="header__cart">
      <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Cart">
        <span class="cart__text">CART</span>
        <span class="cart__count">({{ cart.item_count }})</span>
      </a>
    </div>

    <!-- Search Icon -->
    <div class="header__search">
      <button class="search-toggle" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M19 19L13 13M15 8C15 11.866 11.866 15 8 15C4.134 15 1 11.866 1 8C1 4.134 4.134 1 8 1C11.866 1 15 4.134 15 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav__content">
      <nav class="mobile-nav__nav">
        <ul class="mobile-nav__list">
          <li class="mobile-nav__item">
            <span class="mobile-nav__category">Category</span>
            <ul class="mobile-nav__sublist">
              <li><a href="{{ collections['bracelets-watches'].url }}">Bracelets & Watches</a></li>
              <li><a href="{{ collections['cuffs'].url }}">Cuffs</a></li>
              <li><a href="{{ collections['earclips'].url }}">Earclips</a></li>
              <li><a href="{{ collections['rings'].url }}">Rings</a></li>
              <li><a href="{{ collections['necklaces'].url }}">Necklaces</a></li>
              <li><a href="{{ collections['brooches'].url }}">Brooches</a></li>
              <li><a href="{{ collections['mens'].url }}">Men's</a></li>
              <li><a href="{{ collections['zodiac-pendant-necklaces'].url }}">Zodiac Pendant Necklaces</a></li>
              <li><a href="{{ collections.all.url }}">All</a></li>
            </ul>
          </li>
          <li class="mobile-nav__item">
            <span class="mobile-nav__category">Collection</span>
            <ul class="mobile-nav__sublist">
              <li><a href="{{ collections['featured-in-feud'].url }}">Featured in Feud</a></li>
              <li><a href="{{ collections['off-season-collection'].url }}">Off-Season Collection</a></li>
              <li><a href="{{ collections['byzantine-collection'].url }}">Byzantine Collection</a></li>
              <li><a href="{{ collections['caged-collection'].url }}">Caged Collection</a></li>
              <li><a href="{{ collections['constellation-collection'].url }}">Constellation Collection</a></li>
              <li><a href="{{ collections['curb-link-collection'].url }}">Curb-Link Collection</a></li>
              <li><a href="{{ collections['night-day-collection'].url }}">Night & Day Collection</a></li>
              <li><a href="{{ collections['stardust-collection'].url }}">Stardust Collection</a></li>
              <li><a href="{{ collections['vintage-verdura'].url }}">Vintage Verdura</a></li>
              <li><a href="{{ collections['very-verdura-gifts-under-15-000'].url }}">Very Verdura Gifts Under $20,000</a></li>
            </ul>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Header Styles */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(248, 246, 245, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(39, 38, 38, 0.1);
  }

  .header__wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .header__menu-toggle {
    background: none;
    border: none;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-base-text);
    cursor: pointer;
  }

  .header__logo {
    flex: 1;
    text-align: center;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo__name {
    font-family: var(--font-heading-family);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--color-base-text);
    line-height: 1;
  }

  .logo__tagline {
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.3em;
    color: var(--color-base-text);
    margin-top: 2px;
  }

  .header__nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-base-background-1);
    border-bottom: 1px solid rgba(39, 38, 38, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }

  .header:hover .header__nav {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__list {
    display: flex;
    justify-content: center;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 20px;
    gap: 40px;
  }

  .nav__link {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-base-text);
    transition: color 0.3s ease;
  }

  .nav__link:hover {
    color: var(--color-accent-gold);
  }

  .nav__item--dropdown {
    position: relative;
  }

  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    background: var(--color-base-background-2);
    border: 1px solid rgba(39, 38, 38, 0.1);
    border-radius: 4px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    margin-top: 10px;
  }

  .nav__item--dropdown:hover .nav__dropdown {
    opacity: 1;
    visibility: visible;
  }

  .dropdown__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 40px;
  }

  .dropdown__title {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-base-text);
    margin-bottom: 20px;
  }

  .dropdown__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dropdown__list li {
    margin-bottom: 12px;
  }

  .dropdown__list a {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 300;
    text-decoration: none;
    color: var(--color-base-text);
    transition: color 0.3s ease;
  }

  .dropdown__list a:hover {
    color: var(--color-accent-gold);
  }

  .header__cart {
    position: relative;
  }

  .cart-link {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-base-text);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .header__search {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .search-toggle {
    background: none;
    border: none;
    color: var(--color-base-text);
    cursor: pointer;
  }

  /* Mobile Navigation */
  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-base-background-1);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-100%);
    transition: all 0.3s ease;
  }

  .mobile-nav.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-nav__content {
    padding: 100px 20px 40px;
    height: 100vh;
    overflow-y: auto;
  }

  .mobile-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav__item {
    margin-bottom: 40px;
  }

  .mobile-nav__category {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-base-text);
    display: block;
    margin-bottom: 20px;
  }

  .mobile-nav__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav__sublist li {
    margin-bottom: 16px;
  }

  .mobile-nav__sublist a {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 300;
    text-decoration: none;
    color: var(--color-base-text);
  }

  /* Responsive */
  .mobile-only {
    display: block;
  }

  .desktop-only {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .mobile-only {
      display: none;
    }

    .desktop-only {
      display: block;
    }

    .header__wrapper {
      padding: 25px 40px;
    }

    .logo__name {
      font-size: 32px;
    }

    .header__search {
      right: 40px;
    }
  }

  /* Body offset for fixed header */
  body {
    padding-top: 80px;
  }

  @media screen and (min-width: 768px) {
    body {
      padding-top: 90px;
    }
  }
</style>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.querySelector('.header__menu-toggle');
    const mobileNav = document.querySelector('.mobile-nav');
    const body = document.body;

    if (menuToggle && mobileNav) {
      menuToggle.addEventListener('click', function() {
        mobileNav.classList.toggle('active');
        body.classList.toggle('nav-open');
      });
    }

    // Close mobile nav when clicking outside
    mobileNav.addEventListener('click', function(e) {
      if (e.target === mobileNav) {
        mobileNav.classList.remove('active');
        body.classList.remove('nav-open');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}