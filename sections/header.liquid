{% comment %}
  Verdura Header Section - 响应式头部导航
  包含logo、移动端菜单、购物车和桌面端导航
{% endcomment %}

<header class="site-header" data-section-id="{{ section.id }}" data-section-type="header">
  <nav class="" role="navigation" aria-label="Primary navigation">
    <ul role="list">
      <!-- 移动端菜单按钮 -->
      <li>
        <button class="btn subnav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航菜单">
          {{ section.settings.menu_text | default: 'MENU' }}
        </button>
      </li>
      
      <!-- Logo -->
      <li>
        <a class="logo btn" href="{{ routes.root_url }}" aria-label="返回首页">
          {% if section.settings.logo != blank %}
            <img 
              src="{{ section.settings.logo | image_url: width: 750 }}" 
              alt="{{ shop.name }}" 
              srcset="{{ section.settings.logo | image_url: width: 375 }} 375w, 
                      {{ section.settings.logo | image_url: width: 550 }} 550w, 
                      {{ section.settings.logo | image_url: width: 750 }} 750w" 
              width="750" 
              height="260" 
              sizes="100vw" 
              fetchpriority="high"
              loading="eager">
          {% else %}
            <span class="site-name">{{ shop.name }}</span>
          {% endif %}
        </a>
      </li>
      
      <!-- 购物车按钮 -->
      <li>
        <button class="btn open-slideover cart-button" type="button" data-slideover="cart" aria-label="打开购物车">
          {{ section.settings.cart_text | default: 'CART' }} (<span class="cartQuantity">{{ cart.item_count }}</span>)
        </button>
      </li>
    </ul>
  </nav>

  <!-- 移动端子导航 -->
  <div class="subnav" id="mobile-menu" aria-hidden="true">
    <div class="close">
      <button type="button" class="label subnav-toggle btn" aria-label="关闭导航菜单">
        <span>{{ section.settings.close_text | default: 'CLOSE' }}</span>
      </button>
    </div>
    
    <menu role="list">
      <!-- The Collection 主菜单项 -->
      <li>
        <a href="{{ section.settings.main_collection_url | default: '/collections/all' }}" class="h2 large the-collection">
          {{ section.settings.main_collection_text | default: 'The Collection' }}
        </a>
        
        <!-- 移动端分类展示 -->
        <div class="collections mobile">
          <!-- 按分类购买 -->
          <ul role="list">
            <li class="label">{{ section.settings.category_label | default: 'Shop by Category' }}</li>
            {% for block in section.blocks %}
              {% if block.type == 'category_link' %}
                <li>
                  <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          
          <!-- 按系列购买 -->
          <ul role="list">
            <li class="label">{{ section.settings.collection_label | default: 'Shop by Collection' }}</li>
            {% for block in section.blocks %}
              {% if block.type == 'collection_link' %}
                <li>
                  <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </li>
      
      <!-- 其他导航页面 -->
      {% for block in section.blocks %}
        {% if block.type == 'page_link' %}
          <li class="label">
            <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </menu>
    
    <!-- 桌面端分类展示 -->
    <div class="collections desktop">
      <ul role="list">
        <li class="label">{{ section.settings.desktop_category_label | default: 'Category' }}</li>
        {% for block in section.blocks %}
          {% if block.type == 'category_link' %}
            <li>
              <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      
      <ul role="list">
        <li class="label">{{ section.settings.desktop_collection_label | default: 'Collection' }}</li>
        {% for block in section.blocks %}
          {% if block.type == 'collection_link' %}
            <li>
              <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  <!-- 搜索功能 -->
  <div class="search">
    <button class="btn search-toggle" type="button" aria-label="打开搜索">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56.966 56.966" xml:space="preserve" aria-hidden="true">
        <path fill="currentColor" d="M55.146 51.887 41.588 37.786c3.486-4.144 5.396-9.358 5.396-14.786 0-12.682-10.318-23-23-23s-23 10.318-23 23 10.318 23 23 23c4.761 0 9.298-1.436 13.177-4.162l13.661 14.208c.571.593 1.339.92 2.162.92.779 0 1.518-.297 2.079-.837 1.192-1.147 1.23-3.049.083-4.242zM23.984 6c9.374 0 17 7.626 17 17s-7.626 17-17 17-17-7.626-17-17 7.626-17 17-17z"></path>
      </svg>
    </button>
    <form action="{{ routes.search_url }}" method="get" novalidate="" role="search">
      <input 
        class="p search-input" 
        type="search" 
        name="q" 
        placeholder="{{ section.settings.search_placeholder | default: 'Search' }}" 
        value="{{ search.terms | escape }}" 
        required="" 
        aria-label="搜索产品">
    </form>
  </div>

  <!-- 覆盖层 -->
  <div class="overlay" aria-hidden="true"></div>
</header>

