{% doc %}
  Image with Text Section

  Flexible image and text layout section that can be configured for different content types.
  Used for sections like Zodiac, Very Verdura, Heritage, etc.

  @param layout {String} Layout direction ('standard' or 'reverse')
  @param background_color {String} Section background color
  @param shape_color {String} Decorative shape color
  @param section_height {String} Section height ('auto', 'medium', 'large')
{% enddoc %}

{% liquid
  assign section_id = 'image-with-text-' | append: section.id
  assign layout = section.settings.layout | default: 'standard'
  assign background_color = section.settings.background_color
  assign shape_color = section.settings.shape_color
  assign section_height = section.settings.section_height | default: 'auto'
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign image_2 = section.settings.image_2
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign text = section.settings.text
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign text_alignment = section.settings.text_alignment | default: 'left'
%}

<section id="{{ section_id }}" class="image-with-text image-with-text--{{ layout }} image-with-text--{{ section_height }}">
  <div class="image-with-text__wrapper">
    <div class="page-width">
      <div class="image-with-text__inner">
        
        <!-- Content Side -->
        <div class="image-with-text__content image-with-text__content--{{ text_alignment }}">
          {%- if heading != blank -%}
            <h2 class="image-with-text__heading h2">{{ heading | escape }}</h2>
          {%- endif -%}
          
          {%- if subheading != blank -%}
            <h3 class="image-with-text__subheading h4">{{ subheading | escape }}</h3>
          {%- endif -%}
          
          {%- if text != blank -%}
            <div class="image-with-text__text rte">
              {{ text }}
            </div>
          {%- endif -%}
          
          {%- if button_text != blank and button_url != blank -%}
            <div class="image-with-text__buttons">
              <a href="{{ button_url }}" class="btn btn--primary">
                {{ button_text | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>

        <!-- Media Side -->
        <div class="image-with-text__media">
          {%- if desktop_image or mobile_image -%}
            <div class="image-with-text__media-wrapper">
              {%- if desktop_image -%}
                <div class="image-with-text__image image-with-text__image--desktop">
                  {{ desktop_image | image_url: width: 800 | image_tag:
                     alt: desktop_image.alt | escape,
                     loading: 'lazy',
                     sizes: '(max-width: 749px) 100vw, 50vw'
                  }}
                </div>
              {%- endif -%}
              
              {%- if mobile_image -%}
                <div class="image-with-text__image image-with-text__image--mobile">
                  {{ mobile_image | image_url: width: 600 | image_tag:
                     alt: mobile_image.alt | escape,
                     loading: 'lazy',
                     sizes: '100vw'
                  }}
                </div>
              {%- endif -%}
              
              {%- if image_2 -%}
                <div class="image-with-text__image image-with-text__image--secondary">
                  {{ image_2 | image_url: width: 600 | image_tag:
                     alt: image_2.alt | escape,
                     loading: 'lazy',
                     sizes: '(max-width: 749px) 50vw, 25vw'
                  }}
                </div>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="image-with-text__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
    
    {%- if shape_color != blank -%}
      <div class="image-with-text__shape" style="background-color: {{ shape_color }};"></div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #{{ section_id }} {
    {%- if background_color != blank -%}
      background-color: {{ background_color }};
    {%- endif -%}
  }

  .image-with-text {
    position: relative;
    padding: var(--spacing-sections-mobile) 0;
    overflow: hidden;
  }

  .image-with-text__wrapper {
    position: relative;
  }

  .image-with-text__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 400px;
  }

  /* Layout Variations */
  .image-with-text--standard .image-with-text__content {
    order: 1;
  }

  .image-with-text--standard .image-with-text__media {
    order: 2;
  }

  .image-with-text--reverse .image-with-text__content {
    order: 2;
  }

  .image-with-text--reverse .image-with-text__media {
    order: 1;
  }

  /* Height Variations */
  .image-with-text--medium .image-with-text__inner {
    min-height: 500px;
  }

  .image-with-text--large .image-with-text__inner {
    min-height: 600px;
  }

  /* Content */
  .image-with-text__content {
    z-index: 2;
    position: relative;
  }

  .image-with-text__content--center {
    text-align: center;
  }

  .image-with-text__content--right {
    text-align: right;
  }

  .image-with-text__heading {
    margin-bottom: 1rem;
    color: var(--color-base-text);
  }

  .image-with-text__subheading {
    margin-bottom: 1.5rem;
    color: var(--color-base-text);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .image-with-text__text {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-base-text);
  }

  .image-with-text__text p {
    margin-bottom: 1rem;
  }

  .image-with-text__text p:last-child {
    margin-bottom: 0;
  }

  .image-with-text__buttons {
    margin-top: 2rem;
  }

  /* Media */
  .image-with-text__media {
    position: relative;
    z-index: 1;
  }

  .image-with-text__media-wrapper {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  /* Two images layout */
  .image-with-text__media-wrapper:has(.image-with-text__image--secondary) {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .image-with-text__media-wrapper:has(.image-with-text__image--secondary) .image-with-text__image--desktop {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .image-with-text__media-wrapper:has(.image-with-text__image--secondary) .image-with-text__image--secondary {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .image-with-text__image {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .image-with-text__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-with-text__image:hover img {
    transform: scale(1.02);
  }

  .image-with-text__image--mobile {
    display: none;
  }

  .image-with-text__placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  /* Decorative Shape */
  .image-with-text__shape {
    position: absolute;
    top: 20%;
    right: -10%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    opacity: 0.1;
    z-index: 0;
  }

  .image-with-text--reverse .image-with-text__shape {
    right: auto;
    left: -10%;
  }

  /* Mobile Styles */
  @media screen and (max-width: 749px) {
    .image-with-text {
      padding: var(--spacing-sections-mobile) 0;
    }

    .image-with-text__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: auto;
    }

    .image-with-text__content,
    .image-with-text__media {
      order: unset !important;
    }

    .image-with-text__media {
      order: 1;
    }

    .image-with-text__content {
      order: 2;
    }

    .image-with-text__image--desktop {
      display: none;
    }

    .image-with-text__image--mobile {
      display: block;
    }

    .image-with-text__media-wrapper:has(.image-with-text__image--secondary) {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    .image-with-text__shape {
      width: 200px;
      height: 200px;
      top: 10%;
    }
  }

  /* Desktop Styles */
  @media screen and (min-width: 750px) {
    .image-with-text {
      padding: var(--spacing-sections-desktop) 0;
    }

    .image-with-text__inner {
      gap: 6rem;
    }
  }

  /* Prevent motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    .image-with-text__image img {
      transition: none;
    }

    .image-with-text__image:hover img {
      transform: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "standard",
          "label": "Image right"
        },
        {
          "value": "reverse",
          "label": "Image left"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional: Use different image for mobile"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second Image",
      "info": "Optional: Displays below main image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "shape_color",
      "label": "Shape Color",
      "info": "Decorative background shape"
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "settings": {
        "heading": "Image with text",
        "text": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
      }
    }
  ]
}
{% endschema %} 