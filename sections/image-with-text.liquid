{% comment %}
  Image with Text Section
  两侧图片+中间文字内容布局，支持自定义背景色和文字样式
{% endcomment %}

<section 
  id="ImageWithText-{{ section.id }}" 
  class="image-with-text image-with-text--{{ section.settings.layout }}"
  style="
    background-color: {{ section.settings.background_color | default: '#f7f7f7' }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  "
>
  <div class="image-with-text__wrapper">
    {%- if section.settings.layout == 'two_images_center_text' -%}
      {%- comment -%} 两侧图片 + 中间文字布局 {%- endcomment -%}
      
      {%- comment -%} 左侧图片 {%- endcomment -%}
      <div class="image-with-text__image image-with-text__image--left">
        {%- if section.settings.image_left != blank -%}
          {{ section.settings.image_left | image_url: width: 600 | image_tag:
            loading: 'lazy',
            alt: section.settings.image_left_alt | default: section.settings.title,
            class: 'image-with-text__img'
          }}
        {%- else -%}
          <div class="image-with-text__placeholder">
            <span class="visually-hidden">{{ 'sections.image_with_text.image_placeholder' | t }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} 中间文字内容 {%- endcomment -%}
      <div class="image-with-text__content">
        <div class="image-with-text__content-wrapper">
          {%- if section.settings.title != blank -%}
            <h2 class="image-with-text__title">
              {{ section.settings.title | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.subtitle != blank -%}
            <h3 class="image-with-text__subtitle">
              {{ section.settings.subtitle | escape }}
            </h3>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="image-with-text__description">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
            <a 
              href="{{ section.settings.button_url }}" 
              class="image-with-text__button btn btn--secondary"
            >
              {{ section.settings.button_text | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} 右侧图片 {%- endcomment -%}
      <div class="image-with-text__image image-with-text__image--right">
        {%- if section.settings.image_right != blank -%}
          {{ section.settings.image_right | image_url: width: 600 | image_tag:
            loading: 'lazy',
            alt: section.settings.image_right_alt | default: section.settings.title,
            class: 'image-with-text__img'
          }}
        {%- else -%}
          <div class="image-with-text__placeholder">
            <span class="visually-hidden">{{ 'sections.image_with_text.image_placeholder' | t }}</span>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      {%- comment -%} 标准左右布局 {%- endcomment -%}
      
      {%- assign image_side = section.settings.layout -%}
      {%- if image_side == 'image_left' -%}
        {%- comment -%} 图片在左，文字在右 {%- endcomment -%}
        <div class="image-with-text__image image-with-text__image--standard">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              alt: section.settings.image_alt | default: section.settings.title,
              class: 'image-with-text__img'
            }}
          {%- else -%}
            <div class="image-with-text__placeholder">
              <span class="visually-hidden">{{ 'sections.image_with_text.image_placeholder' | t }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="image-with-text__content image-with-text__content--standard">
          <div class="image-with-text__content-wrapper">
            {%- if section.settings.title != blank -%}
              <h2 class="image-with-text__title">
                {{ section.settings.title | escape }}
              </h2>
            {%- endif -%}

            {%- if section.settings.subtitle != blank -%}
              <h3 class="image-with-text__subtitle">
                {{ section.settings.subtitle | escape }}
              </h3>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <div class="image-with-text__description">
                {{ section.settings.description }}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
              <a 
                href="{{ section.settings.button_url }}" 
                class="image-with-text__button btn btn--secondary"
              >
                {{ section.settings.button_text | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>

      {%- else -%}
        {%- comment -%} 文字在左，图片在右 {%- endcomment -%}
        <div class="image-with-text__content image-with-text__content--standard">
          <div class="image-with-text__content-wrapper">
            {%- if section.settings.title != blank -%}
              <h2 class="image-with-text__title">
                {{ section.settings.title | escape }}
              </h2>
            {%- endif -%}

            {%- if section.settings.subtitle != blank -%}
              <h3 class="image-with-text__subtitle">
                {{ section.settings.subtitle | escape }}
              </h3>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <div class="image-with-text__description">
                {{ section.settings.description }}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
              <a 
                href="{{ section.settings.button_url }}" 
                class="image-with-text__button btn btn--secondary"
              >
                {{ section.settings.button_text | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="image-with-text__image image-with-text__image--standard">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              alt: section.settings.image_alt | default: section.settings.title,
              class: 'image-with-text__img'
            }}
          {%- else -%}
            <div class="image-with-text__placeholder">
              <span class="visually-hidden">{{ 'sections.image_with_text.image_placeholder' | t }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
.image-with-text {
  padding: 60px 20px;
}

.image-with-text__wrapper {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  gap: 40px;
  align-items: center;
}

/* 两侧图片 + 中间文字布局 */
.image-with-text--two_images_center_text .image-with-text__wrapper {
  grid-template-columns: 1fr 2fr 1fr;
  grid-template-areas: "left-image content right-image";
}

.image-with-text__image--left {
  grid-area: left-image;
}

.image-with-text__content {
  grid-area: content;
  text-align: center;
  padding: 0 20px;
}

.image-with-text__image--right {
  grid-area: right-image;
}

/* 标准左右布局 */
.image-with-text--image_left .image-with-text__wrapper,
.image-with-text--image_right .image-with-text__wrapper {
  grid-template-columns: 1fr 1fr;
}

.image-with-text__content--standard {
  padding: 0 40px;
}

/* 图片样式 */
.image-with-text__image {
  position: relative;
}

.image-with-text__img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  transition: transform 0.3s ease;
}

.image-with-text__image:hover .image-with-text__img {
  transform: scale(1.02);
}

.image-with-text__placeholder {
  width: 100%;
  aspect-ratio: 4 / 5;
  background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%),
              linear-gradient(-45deg, #f0f0f0 25%, transparent 25%),
              linear-gradient(45deg, transparent 75%, #f0f0f0 75%),
              linear-gradient(-45deg, transparent 75%, #f0f0f0 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 文字内容样式 */
.image-with-text__content-wrapper {
  max-width: 500px;
  margin: 0 auto;
}

.image-with-text__title {
  font-size: 2.5rem;
  font-weight: 300;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
  color: #333;
  letter-spacing: 0.02em;
}

.image-with-text__subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 1.5rem 0;
  color: #666;
  font-style: italic;
}

.image-with-text__description {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem 0;
  color: #555;
}

.image-with-text__description p {
  margin: 0 0 1rem 0;
}

.image-with-text__description p:last-child {
  margin-bottom: 0;
}

.image-with-text__button {
  margin-top: 1rem;
}

/* 响应式设计 */
@media screen and (max-width: 768px) {
  .image-with-text {
    padding: 40px 15px;
  }
  
  .image-with-text__wrapper {
    gap: 30px;
  }
  
  /* 两侧图片布局在移动端变为垂直 */
  .image-with-text--two_images_center_text .image-with-text__wrapper {
    grid-template-columns: 1fr;
    grid-template-areas: 
      "left-image"
      "content" 
      "right-image";
  }
  
  .image-with-text__content {
    padding: 0 10px;
  }
  
  /* 标准布局在移动端也变为垂直 */
  .image-with-text--image_left .image-with-text__wrapper,
  .image-with-text--image_right .image-with-text__wrapper {
    grid-template-columns: 1fr;
  }
  
  .image-with-text__content--standard {
    padding: 0 20px;
  }
  
  .image-with-text__title {
    font-size: 2rem;
  }
  
  .image-with-text__subtitle {
    font-size: 1.1rem;
  }
}

@media screen and (max-width: 480px) {
  .image-with-text__title {
    font-size: 1.8rem;
  }
  
  .image-with-text__content {
    padding: 0 5px;
  }
  
  .image-with-text__content--standard {
    padding: 0 10px;
  }
}

/* 高对比度模式 */
@media (prefers-contrast: more) {
  .image-with-text__title,
  .image-with-text__subtitle,
  .image-with-text__description {
    color: #000;
  }
  
  .image-with-text__img {
    border: 2px solid #000;
  }
}

/* 减少动画模式 */
@media (prefers-reduced-motion: reduce) {
  .image-with-text__img {
    transition: none;
  }
  
  .image-with-text__image:hover .image-with-text__img {
    transform: none;
  }
}
</style>

{% schema %}
{
  "name": "图文组合",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "布局样式",
      "options": [
        {
          "value": "two_images_center_text",
          "label": "两侧图片 + 中间文字"
        },
        {
          "value": "image_left",
          "label": "图片在左，文字在右"
        },
        {
          "value": "image_right",
          "label": "文字在左，图片在右"
        }
      ],
      "default": "two_images_center_text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#f7f7f7"
    },
    {
      "type": "header",
      "content": "两侧图片设置",
      "info": "仅在"两侧图片 + 中间文字"布局中使用"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "左侧图片"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "左侧图片描述"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "右侧图片"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "右侧图片描述"
    },
    {
      "type": "header",
      "content": "标准图片设置",
      "info": "在左右布局中使用"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "图片描述"
    },
    {
      "type": "header",
      "content": "文字内容"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Zodiac"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "Pendant Necklaces"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述文字",
      "default": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接"
    },
    {
      "type": "header",
      "content": "间距设置"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "顶部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "底部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "图文组合",
      "settings": {
        "layout": "two_images_center_text",
        "title": "Zodiac",
        "subtitle": "Pendant Necklaces",
        "description": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>",
        "button_text": "View Collection"
      }
    }
  ]
}
{% endschema %} 