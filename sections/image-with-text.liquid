{% comment %}
  Image with Text Section
  图文组合区域 - 两侧图片 + 中间文字布局，可在主题编辑器中配置
  适用于Zodiac、Very Verdura等多种用途
{% endcomment %}

<section 
  id="ImageWithText-{{ section.id }}" 
  class="image-with-text-section"
  style="
    background-color: {{ section.settings.background_color | default: '#f7f7f7' }};
    padding: {{ section.settings.section_padding_top | default: 60 }}px 20px {{ section.settings.section_padding_bottom | default: 60 }}px;
  "
>
  <div class="page-width">
    <div class="image-with-text-wrapper">
      
      {%- comment -%} 左侧图片 {%- endcomment -%}
      <div class="image-with-text__image image-with-text__image--left">
        {%- if section.settings.image_left != blank -%}
          {{ section.settings.image_left | image_url: width: 600 | image_tag:
            loading: 'lazy',
            alt: section.settings.image_left_alt | default: section.settings.title,
            class: 'image-with-text__img'
          }}
        {%- else -%}
          <div class="image-with-text__placeholder">
            <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
              <rect width="300" height="400" fill="#e5e5e5"/>
              <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">
                {{ 'sections.image_with_text.image_placeholder' | t }}
              </text>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} 中间文字内容 {%- endcomment -%}
      <div class="image-with-text__content">
        <div class="image-with-text__content-wrapper">
          {%- if section.settings.title != blank -%}
            <h2 class="image-with-text__title">
              {{ section.settings.title | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.subtitle != blank -%}
            <h3 class="image-with-text__subtitle">
              {{ section.settings.subtitle | escape }}
            </h3>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="image-with-text__description">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
            <a 
              href="{{ section.settings.button_url }}" 
              class="image-with-text__button btn btn--secondary"
            >
              {{ section.settings.button_text | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} 右侧图片 {%- endcomment -%}
      <div class="image-with-text__image image-with-text__image--right">
        {%- if section.settings.image_right != blank -%}
          {{ section.settings.image_right | image_url: width: 600 | image_tag:
            loading: 'lazy',
            alt: section.settings.image_right_alt | default: section.settings.title,
            class: 'image-with-text__img'
          }}
        {%- else -%}
          <div class="image-with-text__placeholder">
            <svg width="300" height="400" viewBox="0 0 300 400" fill="none">
              <rect width="300" height="400" fill="#e5e5e5"/>
              <text x="150" y="200" text-anchor="middle" fill="#999" font-size="14">
                {{ 'sections.image_with_text.image_placeholder' | t }}
              </text>
            </svg>
          </div>
        {%- endif -%}
      </div>
      
    </div>
  </div>
</section>

{% stylesheet %}
.image-with-text-section {
  background-color: #f7f7f7;
}

.image-with-text-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;
  align-items: center;
}

/* 图片样式 */
.image-with-text__image {
  position: relative;
  text-align: center;
}

.image-with-text__img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  transition: transform 0.3s ease;
}

.image-with-text__image:hover .image-with-text__img {
  transform: scale(1.02);
}

.image-with-text__placeholder {
  display: inline-block;
  border-radius: 8px;
  overflow: hidden;
}

/* 文字内容样式 */
.image-with-text__content {
  text-align: center;
  padding: 0 20px;
}

.image-with-text__content-wrapper {
  max-width: 500px;
  margin: 0 auto;
}

.image-with-text__title {
  font-size: 2.5rem;
  font-weight: 300;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
  color: #333;
  letter-spacing: 0.02em;
}

.image-with-text__subtitle {
  font-size: 1.2rem;
  font-weight: 400;
  margin: 0 0 1.5rem 0;
  color: #666;
  font-style: italic;
}

.image-with-text__description {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem 0;
  color: #555;
}

.image-with-text__description p {
  margin: 0 0 1rem 0;
}

.image-with-text__description p:last-child {
  margin-bottom: 0;
}

.image-with-text__button {
  margin-top: 1rem;
}

/* 响应式设计 */
@media screen and (max-width: 768px) {
  .image-with-text-wrapper {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .image-with-text__content {
    padding: 0 10px;
  }
  
  .image-with-text__title {
    font-size: 2rem;
  }
  
  .image-with-text__subtitle {
    font-size: 1.1rem;
  }
}

@media screen and (max-width: 480px) {
  .image-with-text__title {
    font-size: 1.8rem;
  }
  
  .image-with-text__content {
    padding: 0 5px;
  }
}

/* 高对比度模式 */
@media (prefers-contrast: more) {
  .image-with-text__title,
  .image-with-text__subtitle,
  .image-with-text__description {
    color: #000;
  }
  
  .image-with-text__img {
    border: 2px solid #000;
  }
}

/* 减少动画模式 */
@media (prefers-reduced-motion: reduce) {
  .image-with-text__img {
    transition: none;
  }
  
  .image-with-text__image:hover .image-with-text__img {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "图文组合",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "左侧图片"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "左侧图片描述",
      "default": "Zodiac Pendant Capricorn"
    },
    {
      "type": "image_picker", 
      "id": "image_right",
      "label": "右侧图片"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "右侧图片描述",
      "default": "Zodiac Pendant Pisces"
    },
    {
      "type": "header",
      "content": "文字内容"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Zodiac"
    },
    {
      "type": "text",
      "id": "subtitle", 
      "label": "副标题",
      "default": "Pendant Necklaces"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述文字",
      "default": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接",
      "default": "/collections/zodiac-pendant-necklaces"
    },
    {
      "type": "header",
      "content": "样式设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "顶部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "底部内边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "图文组合",
      "settings": {
        "title": "Zodiac",
        "subtitle": "Pendant Necklaces",
        "description": "<p>Using archival postcards Fulco di Verdura purchased at the Museum of Natural History, Verdura sets diamonds as stars and engraves constellations in gold</p>",
        "button_text": "View Collection",
        "button_url": "/collections/zodiac-pendant-necklaces"
      }
    }
  ]
}
{% endschema %} 